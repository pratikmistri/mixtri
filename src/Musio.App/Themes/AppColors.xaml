<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ═══════════════════════════════════════════════════════════════
             DEFAULT (Dark) — preserves the original hard-coded values
             ═══════════════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Default">

            <!-- ── Shared overlay colors ── -->
            <SolidColorBrush x:Key="OverlayDimBrush"          Color="#80000000" />
            <SolidColorBrush x:Key="OverlayDenseBrush"        Color="#C0000000" />
            <SolidColorBrush x:Key="OverlayForegroundBrush"   Color="#FFFFFFFF" />

            <!-- ── Timeline — semantic status colors (all other timeline colors
                 are resolved from standard WinUI system brushes at runtime) ── -->
            <SolidColorBrush x:Key="TimelinePlayheadOverlayBrush"         Color="#FFDDFF00" />
            <SolidColorBrush x:Key="TimelinePlayheadBrush"                Color="#FFDDFF00" />
            <SolidColorBrush x:Key="TimelineCutLineBrush"                 Color="#C8FFFF64" />
            <SolidColorBrush x:Key="TimelineSpeedUpOverlayBrush"          Color="#C8E6A032" />
            <SolidColorBrush x:Key="TimelineSlowDownOverlayBrush"         Color="#C83C82E6" />
            <SolidColorBrush x:Key="TimelineCursorPathYBrush"             Color="#DCFFA064" />
            <SolidColorBrush x:Key="TimelineCursorClickBrush"             Color="#FFFF5050" />

            <!-- ── Preview canvas ── -->
            <SolidColorBrush x:Key="PreviewSurfaceClearBrush"  Color="#FF141414" />

            <!-- ── Region selector ── -->
            <SolidColorBrush x:Key="RegionMaskBrush"             Color="#4D000000" />
            <SolidColorBrush x:Key="RegionSelectionStrokeBrush"  Color="#FF0078D4" />
            <SolidColorBrush x:Key="RegionHandleFillBrush"       Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="RegionLabelBackgroundBrush"  Color="#CC000000" />

            <!-- ── Recording overlay ── -->
            <AcrylicBrush x:Key="RecordingOverlayBackgroundBrush"
                          TintColor="#1E1E1E" TintOpacity="0.8"
                          FallbackColor="#E01E1E1E" />
            <SolidColorBrush x:Key="RecordingIndicatorBrush"       Color="#FFFF3B30" />
            <SolidColorBrush x:Key="RecordingStopBackgroundBrush"  Color="#40FF3B30" />
            <SolidColorBrush x:Key="RecordingStopBorderBrush"      Color="#60FF3B30" />
        </ResourceDictionary>

        <!-- ═══════════════════════════════════════════════════════════════
             HIGH CONTRAST — maps to system colors for accessibility
             ═══════════════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="HighContrast">

            <!-- ── Shared overlay colors ── -->
            <SolidColorBrush x:Key="OverlayDimBrush"          Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlayDenseBrush"        Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlayForegroundBrush"   Color="{StaticResource SystemColorWindowTextColor}" />

            <!-- ── Timeline — semantic status colors (HC overrides) ── -->
            <SolidColorBrush x:Key="TimelinePlayheadOverlayBrush"         Color="{StaticResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="TimelinePlayheadBrush"                Color="{StaticResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="TimelineCutLineBrush"                 Color="{StaticResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="TimelineSpeedUpOverlayBrush"          Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TimelineSlowDownOverlayBrush"         Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TimelineCursorPathYBrush"             Color="{StaticResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="TimelineCursorClickBrush"             Color="{StaticResource SystemColorHotlightColor}" />

            <!-- ── Preview canvas ── -->
            <SolidColorBrush x:Key="PreviewSurfaceClearBrush"  Color="{StaticResource SystemColorWindowColor}" />

            <!-- ── Region selector ── -->
            <SolidColorBrush x:Key="RegionMaskBrush"             Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RegionSelectionStrokeBrush"  Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RegionHandleFillBrush"       Color="{StaticResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="RegionLabelBackgroundBrush"  Color="{StaticResource SystemColorWindowColor}" />

            <!-- ── Recording overlay ── -->
            <SolidColorBrush x:Key="RecordingOverlayBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RecordingIndicatorBrush"       Color="{StaticResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="RecordingStopBackgroundBrush"  Color="{StaticResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="RecordingStopBorderBrush"      Color="{StaticResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
