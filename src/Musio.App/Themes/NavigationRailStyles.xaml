<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Store-style navigation rail item: icon stacked over label, centred across the full
        rail width. Selecting an item drops its label so the icon centres on its own.

        NavigationView has no built-in mode for this, and its stock item cannot be coaxed
        into it:
          * Assigning a UIElement to NavigationViewItem.Content CRASHES the XAML runtime
            (0xc000027b) as the item is realised, so the layout cannot be passed as content.
          * The stock item gives the label only the width left beside a reserved icon column,
            clamping captions to ~26px in a 72px rail and clipping every one. That layout
            lives in NavigationViewItemPresenter, and an implicit style for the presenter is
            ignored from both NavigationView.Resources and Application.Resources (verified
            with a presenter template whose red background never rendered) because
            NavigationViewItem supplies its presenter's style itself.

        Templating NavigationViewItem directly does take effect. The icon and label live in
        this template rather than in a ContentTemplate so the visual states can address the
        label directly — a state Setter cannot reach inside a ContentPresenter's DataTemplate.
        Items therefore use the native Icon and Content (a plain string) properties.
    -->
    <Style TargetType="NavigationViewItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItem">
                    <!-- Stretch vertically: if the root only sized to its content the item
                         would centre that content in a taller slot, leaving the selection
                         bar sitting above the item's true centre. -->
                    <Grid x:Name="LayoutRoot"
                          Background="Transparent"
                          VerticalAlignment="Stretch"
                          MinHeight="{TemplateBinding MinHeight}">
                        <Border x:Name="ItemBackground"
                                Background="Transparent"
                                CornerRadius="4" />

                        <!-- Deliberately NOT named "SelectionIndicator": NavigationView looks
                             up a template part with that name and animates its position
                             itself, which yanked this bar to the top of the item on every
                             navigation. Renaming it also opts out of that animation, so the
                             grow/fade is driven from the visual states below. -->
                        <Border x:Name="RailSelectionBar"
                                Width="3"
                                Height="20"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                CornerRadius="2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RailSelectionBarScale" ScaleY="0" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="ContentStack"
                                    Spacing="6"
                                    Padding="0,10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Opacity="0.6">
                            <ContentPresenter x:Name="IconHost"
                                              Content="{TemplateBinding Icon}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="IconTranslate" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                            <!-- The label keeps its layout space when selected and only fades
                                 out, while the icon is translated down over it. Collapsing the
                                 label instead would be unanimatable (Visibility is not) and
                                 would make the item's height jump on every selection. -->
                            <TextBlock x:Name="LabelHost"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBarScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Deselecting has to reverse the label fade and icon
                                             glide, otherwise an item keeps its icon shifted
                                             down over an invisible label after losing selection. -->
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelHost"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="IconTranslate"
                                            Storyboard.TargetProperty="Y"
                                            To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentStack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.6" Duration="0:0:0.18" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="ContentStack.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <!-- Selected: the label is dropped and the icon centres itself,
                                     since ContentStack is centred and the label is the only
                                     other thing in it. -->
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <!-- Accent tint marks the active destination. -->
                                        <Setter Target="IconHost.Foreground"
                                                Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBarScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelHost"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="IconTranslate"
                                            Storyboard.TargetProperty="Y"
                                            To="11" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentStack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <!-- Accent tint marks the active destination. -->
                                        <Setter Target="IconHost.Foreground"
                                                Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBarScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1" Duration="0:0:0.12" />
                                    
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelHost"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="IconTranslate"
                                            Storyboard.TargetProperty="Y"
                                            To="11" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentStack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <!-- Accent tint marks the active destination. -->
                                        <Setter Target="IconHost.Foreground"
                                                Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RailSelectionBarScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1" Duration="0:0:0.12" />
                                    
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelHost"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="IconTranslate"
                                            Storyboard.TargetProperty="Y"
                                            To="11" Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentStack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
