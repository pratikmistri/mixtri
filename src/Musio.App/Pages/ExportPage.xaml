<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Musio_App.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- InfoBar for export status -->
        <InfoBar
            x:Name="ExportInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Success" />

        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel MaxWidth="640" Spacing="12">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="40" />
                </StackPanel.ChildrenTransitions>

                <!-- Page header -->
                <StackPanel Spacing="4" Margin="0,0,0,8">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Export" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Export your recording as MP4" />
                </StackPanel>

                <!-- Output path -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="OUTPUT" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="Output file path…"
                            Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.BrowseOutputPathCommand}"
                            Content="Browse…"
                            ToolTipService.ToolTip="Choose a different location" />
                    </Grid>
                </StackPanel>

                <!-- Export / Cancel buttons -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Export your recording">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE898;" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Export Video" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.CancelExportCommand}"
                        Content="Cancel"
                        ToolTipService.ToolTip="Cancel the current export"
                        Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay}" />
                </Grid>

                <!-- Progress section -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay}">
                    <ProgressBar
                        Maximum="100"
                        Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ProgressStatus, Mode=OneWay}" />
                </StackPanel>

                <!-- Success: open folder -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ExportSucceeded, Mode=OneWay}">
                    <Button
                        Command="{x:Bind ViewModel.OpenOutputFolderCommand}"
                        ToolTipService.ToolTip="Show exported file in Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                            <TextBlock Text="Open in Explorer" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
