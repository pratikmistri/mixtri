<Page
    x:Class="Musio_App.Pages.OpenProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Musio_App.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- The stock GridViewHeaderItem style indents its content by 12px and hard-codes
             a divider Rectangle beneath it. Neither is reachable with setters, and unlike
             GridViewItem there is no keyed default style to derive from (generic.xaml
             declares GridViewHeaderItem's style implicitly, with no x:Key), so the
             template is restated here without the divider and with the left padding
             dropped, which lines the header up with the page title and the cards.
             Everything else mirrors the stock setters. -->
        <Style x:Key="ProjectsGroupHeaderStyle" TargetType="GridViewHeaderItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0,8,0,0" />
            <Setter Property="MinHeight" Value="{ThemeResource GridViewHeaderItemMinHeight}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewHeaderItem">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ItemsPath names the child collection on each ProjectGroup; without it a
             grouped source renders the groups themselves as items. -->
        <CollectionViewSource
            x:Name="ProjectsSource"
            IsSourceGrouped="True"
            ItemsPath="Items" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="SemiBold"
                Text="Projects" />

            <Button
                Grid.Column="1"
                Height="36"
                VerticalAlignment="Center"
                Click="Open_Click"
                ToolTipService.ToolTip="Open a .musio project from anywhere on disk">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    <TextBlock Text="Open" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                FontSize="36"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No saved projects yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Record something, then use Save in the editor." />
        </StackPanel>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <GridView
            x:Name="ProjectsGrid"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="ProjectsGrid_ItemClick"
            SelectionMode="None">
            <!-- Spacing lives on the container, not on the card inside it. A margin on the
                 template root sits INSIDE the GridViewItem, so the hover backplate would be
                 drawn over the card plus that margin and spill past its right and bottom
                 edges. Padding is zeroed and content stretched for the same reason. -->
            <GridView.ItemContainerStyle>
                <!-- BasedOn matters: a bare Style replaces the default one outright, which
                     drops the presenter setters that give the hover/selection backplate its
                     rounded corners. -->
                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ProjectCard">
                    <Grid
                        Width="260"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Height="140"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="8,8,0,0">
                            <Grid>
                                <FontIcon
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE714;" />
                                <Image
                                    Source="{x:Bind Poster}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Padding="12,10"
                            Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Path}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Subtitle}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource ProjectsGroupHeaderStyle}" HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:ProjectGroup">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Header}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
        </GridView>
    </Grid>
</Page>
