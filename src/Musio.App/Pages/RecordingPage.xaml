<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar for recording status -->
        <InfoBar
            x:Name="RecordingInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Centered Toolbar -->
        <Border
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="6">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="30" />
                </TransitionCollection>
            </Border.Transitions>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Options section (disabled during recording) -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    IsHitTestVisible="{x:Bind InvertBool(ViewModel.IsRecording), Mode=OneWay}"
                    Opacity="{x:Bind RecordingOpacity(ViewModel.IsRecording), Mode=OneWay}">

                    <!-- Capture Mode -->
                    <ctk:Segmented
                        x:Name="CaptureModeSelector"
                        Height="36"
                        SelectionChanged="CaptureModeSelector_SelectionChanged">
                        <ctk:Segmented.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="SegmentedItemBackgroundSelected" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="SegmentedItemBackgroundSelected" Color="{StaticResource SystemColorHighlightColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </ctk:Segmented.Resources>
                        <ctk:SegmentedItem Content="Full Screen" Tag="FullScreen">
                            <ctk:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE740;" />
                            </ctk:SegmentedItem.Icon>
                        </ctk:SegmentedItem>
                        <ctk:SegmentedItem Content="Window" Tag="Window">
                            <ctk:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE737;" />
                            </ctk:SegmentedItem.Icon>
                        </ctk:SegmentedItem>
                        <ctk:SegmentedItem Content="Region" Tag="CustomRegion">
                            <ctk:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE7A8;" />
                            </ctk:SegmentedItem.Icon>
                        </ctk:SegmentedItem>
                    </ctk:Segmented>

                    <!-- Inline: Window picker (expands when Window mode selected) -->
                    <StackPanel x:Name="WindowPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                        <AppBarSeparator />
                        <DropDownButton
                            x:Name="SelectWindowButton"
                            VerticalAlignment="Center"
                            Content="Select Window"
                            ToolTipService.ToolTip="Click to visually select a window">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Pick from screen" Click="SelectWindowButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE737;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <!-- Inline: Region selector (expands when Region mode selected) -->
                    <StackPanel x:Name="RegionPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                        <AppBarSeparator />
                        <DropDownButton
                            x:Name="SelectRegionButton"
                            VerticalAlignment="Center"
                            Content="Select Region"
                            ToolTipService.ToolTip="Click to select a custom screen region">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Draw region on screen" Click="SelectRegionButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7A8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <AppBarSeparator />

                    <!-- Audio & Camera toggles -->
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsMicEnabled, Mode=TwoWay}"
                        ToolTipService.ToolTip="Microphone"
                        VerticalAlignment="Center"
                        Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE720;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsSystemAudioEnabled, Mode=TwoWay}"
                        ToolTipService.ToolTip="System Audio"
                        VerticalAlignment="Center"
                        Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE767;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsWebcamEnabled, Mode=TwoWay}"
                        ToolTipService.ToolTip="Camera"
                        VerticalAlignment="Center"
                        Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE714;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>

                <AppBarSeparator />

                <!-- Record button (visible when not recording) -->
                <Button
                    x:Name="StartRecordButton"
                    VerticalAlignment="Center"
                    Height="36"
                    Padding="12,0"
                    Click="StartRecordButton_Click"
                    CornerRadius="18"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind InvertBoolToVisibility(ViewModel.IsRecording), Mode=OneWay}"
                    ToolTipService.ToolTip="Start recording (Ctrl+Shift+R)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE7C8;" />
                        <TextBlock Text="Record" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Stop button + timer (visible during recording) -->
                <Button
                    x:Name="StopRecordButton"
                    VerticalAlignment="Center"
                    Height="36"
                    Width="36"
                    Padding="0"
                    CornerRadius="18"
                    Command="{x:Bind ViewModel.StopRecordingCommand}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}"
                    ToolTipService.ToolTip="Stop recording">
                    <FontIcon FontSize="16" Foreground="Red" Glyph="&#xE71A;" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="Red"
                    Margin="4,0,2,0"
                    Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Selection metadata text below toolbar -->
        <TextBlock
            x:Name="SelectionMetadataText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,80,0,0"
            MaxWidth="400"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
            TextAlignment="Center"
            Visibility="Collapsed" />

        <!-- TeachingTip for first-run -->
        <TeachingTip
            x:Name="QuickRecordTip"
            Title="Quick Record"
            Subtitle="Press Ctrl+Shift+R to start recording instantly from anywhere."
            IsLightDismissEnabled="True"
            PreferredPlacement="Bottom" />

        <!-- Status Bar -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RecordingStatus, Mode=OneWay}" />
                </StackPanel>
                <ProgressRing
                    x:Name="RecordingProgressRing"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsRecording, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
