<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:controls="using:Musio_App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- InfoBar for recording status -->
        <InfoBar
            x:Name="RecordingInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Centered toolbar + metadata + record button -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="0">

            <!-- The same control the Mini window hosts, minus its inline Record
                 button — this page renders a hero-sized one below instead. -->
            <controls:RecordToolbarControl x:Name="Toolbar" HorizontalAlignment="Center" />

            <!-- Selection metadata text below toolbar -->
            <TextBlock
                x:Name="SelectionMetadataText"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                MaxWidth="400"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextAlignment="Center"
                Visibility="Collapsed" />

            <!-- Record button — hero style (visible when not recording) -->
            <Button
                x:Name="StartRecordButton"
                HorizontalAlignment="Center"
                Margin="0,32,0,0"
                Height="60"
                Padding="40,0"
                Click="StartRecordButton_Click"
                CornerRadius="30"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind InvertBoolToVisibility(ViewModel.IsRecording), Mode=OneWay}"
                ToolTipService.ToolTip="Start recording">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="18" Glyph="&#xE7C8;" />
                    <TextBlock Text="Record" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Stop button + timer (visible during recording) -->
            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,32,0,0"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}">
                <Button
                    x:Name="StopRecordButton"
                    Height="48"
                    Width="48"
                    Padding="0"
                    CornerRadius="24"
                    Command="{x:Bind ViewModel.StopRecordingCommand}"
                    ToolTipService.ToolTip="Stop recording">
                    <FontIcon FontSize="18" Foreground="Red" Glyph="&#xE71A;" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="Red"
                    Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}" />
            </StackPanel>

        </StackPanel>

        <!-- TeachingTip for first-run -->
        <TeachingTip
            x:Name="QuickRecordTip"
            Title="Quick Record"
            Subtitle="Use Mini mode to keep recording controls available without opening the full app."
            IsLightDismissEnabled="True"
            PreferredPlacement="Bottom" />
    </Grid>
</Page>
