<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Musio_App.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StartRecordText.Visibility" Value="Visible" />
                        <Setter Target="StopRecordText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StartRecordText.Visibility" Value="Collapsed" />
                        <Setter Target="StopRecordText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar for recording status -->
        <InfoBar
            x:Name="RecordingInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <ScrollViewer Grid.Row="1" Padding="16" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="24">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="40" />
                </StackPanel.ChildrenTransitions>

                <!-- Hero: Start / Stop Recording -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Button
                        x:Name="StartRecordButton"
                        Height="64"
                        MinWidth="64"
                        Padding="24,0"
                        Command="{x:Bind ViewModel.StartRecordingCommand}"
                        CornerRadius="32"
                        IsEnabled="{x:Bind InvertBool(ViewModel.IsRecording), Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Start a new screen recording (Ctrl+Shift+R)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="22" Glyph="&#xE7C8;" />
                            <TextBlock
                                x:Name="StartRecordText"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Start Recording" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="StopRecordButton"
                        Height="64"
                        MinWidth="64"
                        Padding="24,0"
                        Command="{x:Bind ViewModel.StopRecordingCommand}"
                        CornerRadius="32"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}"
                        ToolTipService.ToolTip="Stop the current recording">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="22" Foreground="Red" Glyph="&#xE71A;" />
                            <TextBlock
                                x:Name="StopRecordText"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Stop Recording" />
                        </StackPanel>
                    </Button>

                    <!-- Elapsed timer shown during recording -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="Red"
                        Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
                </StackPanel>

                <!-- TeachingTip for first-run -->
                <TeachingTip
                    x:Name="QuickRecordTip"
                    Title="Quick Record"
                    Subtitle="Press Ctrl+Shift+R to start recording instantly from anywhere."
                    IsLightDismissEnabled="True"
                    PreferredPlacement="Bottom" />

                <!-- Capture Mode (disabled during recording) -->
                <StackPanel
                    HorizontalAlignment="Center"
                    MaxWidth="480"
                    Spacing="12"
                    IsHitTestVisible="{x:Bind InvertBool(ViewModel.IsRecording), Mode=OneWay}"
                    Opacity="{x:Bind RecordingOpacity(ViewModel.IsRecording), Mode=OneWay}">
                    <ctk:Segmented
                        x:Name="CaptureModeSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="CaptureModeSelector_SelectionChanged">
                        <ctk:SegmentedItem Content="Full Screen" Tag="FullScreen">
                            <ctk:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE740;" />
                            </ctk:SegmentedItem.Icon>
                        </ctk:SegmentedItem>
                        <ctk:SegmentedItem Content="Window" Tag="Window">
                            <ctk:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE737;" />
                            </ctk:SegmentedItem.Icon>
                        </ctk:SegmentedItem>
                        <ctk:SegmentedItem Content="Region" Tag="CustomRegion">
                            <ctk:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE7A8;" />
                            </ctk:SegmentedItem.Icon>
                        </ctk:SegmentedItem>
                    </ctk:Segmented>

                    <!-- Region selection (visible when Custom Region is selected) -->
                    <StackPanel x:Name="RegionPanel" Spacing="8" Visibility="Collapsed">
                        <Button
                            x:Name="SelectRegionButton"
                            HorizontalAlignment="Stretch"
                            Click="SelectRegionButton_Click"
                            Content="Select Region"
                            ToolTipService.ToolTip="Click to select a custom screen region" />
                        <TextBlock
                            x:Name="RegionInfoText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Window selection (visible when Window is selected) -->
                    <StackPanel x:Name="WindowPanel" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="WindowComboBox"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Select a window…"
                                ItemsSource="{x:Bind ViewModel.AvailableWindows}"
                                SelectionChanged="WindowComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WindowItem">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE737;" FontSize="16" />
                                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" />
                                            </Grid>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="280" />
                                                <TextBlock Text="{x:Bind ProcessName}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                Click="RefreshWindows_Click"
                                ToolTipService.ToolTip="Refresh window list">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RecordingStatus, Mode=OneWay}" />
                </StackPanel>
                <ProgressRing
                    x:Name="RecordingProgressRing"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsRecording, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
