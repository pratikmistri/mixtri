<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Musio_App.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar for recording status -->
        <InfoBar
            x:Name="RecordingInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Centered Mini Setup toolbar (extracted in Phase A) -->
        <controls:MiniSetupControl
            x:Name="Toolbar"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- TeachingTip for first-run -->
        <TeachingTip
            x:Name="QuickRecordTip"
            Title="Quick Record"
            Subtitle="Press Ctrl+Shift+R to start recording instantly from anywhere."
            IsLightDismissEnabled="True"
            PreferredPlacement="Bottom" />

        <!-- Status Bar -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RecordingStatus, Mode=OneWay}" />
                </StackPanel>
                <ProgressRing
                    x:Name="RecordingProgressRing"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsRecording, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
