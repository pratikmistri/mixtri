<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Musio_App.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar for recording status -->
        <InfoBar
            x:Name="RecordingInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Hero column: toolbar + selection metadata + hero Record/Stop -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="0">

            <!-- Compact Mini Setup toolbar (extracted in Phase A; restructured to
                 ~64px tall in Phase B). The page hides the toolbar's own inline
                 Record button so it can render its own hero Record below. -->
            <controls:MiniSetupControl
                x:Name="Toolbar"
                HorizontalAlignment="Center"
                ShowInlineRecordButton="False" />

            <!-- Selection metadata text (e.g. "Region: 1920x1080 at (0,0)").
                 Phase B moved this out of MiniSetupControl so the compact 64px
                 toolbar variant stays at its target height. -->
            <TextBlock
                x:Name="SelectionMetadataText"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                MaxWidth="400"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextAlignment="Center"
                Visibility="Collapsed" />

            <!-- Hero Record button (visible when not recording) -->
            <Button
                x:Name="HeroRecordButton"
                HorizontalAlignment="Center"
                Margin="0,32,0,0"
                Height="60"
                Padding="40,0"
                Click="HeroRecordButton_Click"
                CornerRadius="30"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind InvertBoolToVisibility(ViewModel.IsRecording), Mode=OneWay}"
                ToolTipService.ToolTip="Start recording (Ctrl+Shift+R)">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="18" Glyph="&#xE7C8;" />
                    <TextBlock Text="Record" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Hero Stop + timer (visible during recording) -->
            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,32,0,0"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}">
                <Button
                    x:Name="HeroStopButton"
                    Height="48"
                    Width="48"
                    Padding="0"
                    CornerRadius="24"
                    Command="{x:Bind ViewModel.StopRecordingCommand}"
                    ToolTipService.ToolTip="Stop recording">
                    <FontIcon FontSize="18" Foreground="Red" Glyph="&#xE71A;" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="Red"
                    Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!-- TeachingTip for first-run -->
        <TeachingTip
            x:Name="QuickRecordTip"
            Title="Quick Record"
            Subtitle="Press Ctrl+Shift+R to start recording instantly from anywhere."
            IsLightDismissEnabled="True"
            PreferredPlacement="Bottom" />

        <!-- Status Bar -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RecordingStatus, Mode=OneWay}" />
                </StackPanel>
                <ProgressRing
                    x:Name="RecordingProgressRing"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsRecording, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
