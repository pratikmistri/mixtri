<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Musio_App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="OptionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar for recording status -->
        <InfoBar
            x:Name="RecordingInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel MaxWidth="900" Spacing="12">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="40" />
                </StackPanel.ChildrenTransitions>

                <!-- Page header -->
                <StackPanel Spacing="4" Margin="0,0,0,8">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Record" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Configure your screen capture settings and start recording" />
                </StackPanel>

                <!-- Hero: Start / Stop Recording -->
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <Button
                        x:Name="StartRecordButton"
                        Width="240"
                        Height="64"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.StartRecordingCommand}"
                        CornerRadius="32"
                        IsEnabled="{x:Bind InvertBool(ViewModel.IsRecording), Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Start a new screen recording (Ctrl+Shift+R)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="22" Glyph="&#xE7C8;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Start Recording" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="StopRecordButton"
                        Width="240"
                        Height="64"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.StopRecordingCommand}"
                        CornerRadius="32"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}"
                        ToolTipService.ToolTip="Stop the current recording">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="22" Foreground="Red" Glyph="&#xE71A;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Stop Recording" />
                        </StackPanel>
                    </Button>

                    <!-- Elapsed timer shown during recording -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="Red"
                        Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
                </StackPanel>

                <!-- TeachingTip for first-run -->
                <TeachingTip
                    x:Name="QuickRecordTip"
                    Title="Quick Record"
                    Subtitle="Press Ctrl+Shift+R to start recording instantly from anywhere."
                    IsLightDismissEnabled="True"
                    PreferredPlacement="Bottom" />

                <!-- Option Cards Grid (disabled during recording) -->
                <Grid ColumnSpacing="16" RowSpacing="16"
                      IsHitTestVisible="{x:Bind InvertBool(ViewModel.IsRecording), Mode=OneWay}"
                      Opacity="{x:Bind RecordingOpacity(ViewModel.IsRecording), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Capture Mode -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OptionCard}">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Capture Mode" />
                            <RadioButtons>
                                <RadioButton
                                    Content="Full Screen"
                                    IsChecked="{x:Bind ViewModel.CaptureMode.Equals(vm:CaptureMode.FullScreen), Mode=OneWay}"
                                    Tag="FullScreen"
                                    Checked="CaptureMode_Checked" />
                                <RadioButton
                                    Content="Window"
                                    IsChecked="{x:Bind ViewModel.CaptureMode.Equals(vm:CaptureMode.Window), Mode=OneWay}"
                                    Tag="Window"
                                    Checked="CaptureMode_Checked" />
                                <RadioButton
                                    Content="Custom Region"
                                    IsChecked="{x:Bind ViewModel.CaptureMode.Equals(vm:CaptureMode.CustomRegion), Mode=OneWay}"
                                    Tag="CustomRegion"
                                    Checked="CaptureMode_Checked" />
                            </RadioButtons>

                            <!-- Region selection (visible when Custom Region is selected) -->
                            <StackPanel x:Name="RegionPanel" Spacing="8" Visibility="Collapsed">
                                <Button
                                    x:Name="SelectRegionButton"
                                    HorizontalAlignment="Stretch"
                                    Click="SelectRegionButton_Click"
                                    Content="Select Region"
                                    ToolTipService.ToolTip="Click to select a custom screen region" />
                                <TextBlock
                                    x:Name="RegionInfoText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audio -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource OptionCard}">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Audio" />
                            <ToggleSwitch
                                Header="System Audio"
                                IsOn="{x:Bind ViewModel.IsSystemAudioEnabled, Mode=TwoWay}"
                                ToolTipService.ToolTip="Capture desktop audio output" />
                            <ComboBox
                                Header="System Audio Device"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Default output"
                                ToolTipService.ToolTip="Select audio output device" />
                            <ToggleSwitch
                                Header="Microphone"
                                IsOn="{x:Bind ViewModel.IsMicEnabled, Mode=TwoWay}"
                                ToolTipService.ToolTip="Record microphone input" />
                            <ComboBox
                                Header="Microphone Device"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Default microphone"
                                ToolTipService.ToolTip="Select microphone input device" />
                        </StackPanel>
                    </Border>

                    <!-- FPS -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OptionCard}">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Frame Rate" />
                            <RadioButtons>
                                <RadioButton
                                    Content="30 fps"
                                    IsChecked="{x:Bind ViewModel.Fps.Equals(30), Mode=OneWay}"
                                    Tag="30"
                                    Checked="Fps_Checked" />
                                <RadioButton
                                    Content="60 fps"
                                    IsChecked="{x:Bind ViewModel.Fps.Equals(60), Mode=OneWay}"
                                    Tag="60"
                                    Checked="Fps_Checked" />
                            </RadioButtons>
                        </StackPanel>
                    </Border>

                    <!-- Webcam -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionCard}">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Webcam" />
                            <ToggleSwitch
                                Header="Enable Webcam"
                                IsOn="{x:Bind ViewModel.IsWebcamEnabled, Mode=TwoWay}"
                                ToolTipService.ToolTip="Show webcam overlay in recording" />
                            <ComboBox
                                Header="Webcam Device"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Default camera"
                                ToolTipService.ToolTip="Select webcam device" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RecordingStatus, Mode=OneWay}" />
                </StackPanel>
                <ProgressRing
                    x:Name="RecordingProgressRing"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsRecording, Mode=OneWay}"
                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
