<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Musio_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Z"
            Invoked="UndoAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Y"
            Invoked="RedoAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="S"
            Invoked="SplitAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Delete"
            Invoked="DeleteAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="X"
            Invoked="CutAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Space"
            Invoked="PlayPauseAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar for editor status -->
        <InfoBar
            x:Name="EditorInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Preview canvas (+ overlays) docked next to the properties pane -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <controls:PreviewCanvas
                x:Name="Preview" />

            <!-- Webcam position overlay (drag to move) -->
            <Canvas x:Name="WebcamOverlayCanvas"
                    SizeChanged="WebcamOverlay_SizeChanged">
                <Border x:Name="WebcamOverlayRect"
                        Background="Transparent"
                        Visibility="Collapsed"
                        PointerPressed="WebcamOverlay_PointerPressed"
                        PointerMoved="WebcamOverlay_PointerMoved"
                        PointerReleased="WebcamOverlay_PointerReleased" />
            </Canvas>

            <!-- Zoom region edit overlay -->
            <Grid x:Name="ZoomRegionOverlay" Visibility="Collapsed">
                <Canvas x:Name="ZoomRegionCanvas"
                        Background="Transparent"
                        PointerPressed="ZoomRegionCanvas_PointerPressed"
                        PointerMoved="ZoomRegionCanvas_PointerMoved"
                        PointerReleased="ZoomRegionCanvas_PointerReleased"
                        SizeChanged="ZoomRegionCanvas_SizeChanged">
                    <Rectangle x:Name="DimTop" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="DimBottom" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="DimLeft" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="DimRight" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="ZoomRegionRect"
                               Stroke="{ThemeResource OverlayForegroundBrush}" StrokeThickness="1"
                               StrokeDashArray="6,3"
                               Fill="Transparent"
                               IsHitTestVisible="False" />
                    <Line x:Name="SnapGuideV" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3,3"
                          Visibility="Collapsed" IsHitTestVisible="False" />
                    <Line x:Name="SnapGuideH" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3,3"
                          Visibility="Collapsed" IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleTL" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleTR" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleBL" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleBR" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                </Canvas>

                <StackPanel
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Padding="12,8"
                    Margin="0,8,0,0"
                    Background="{ThemeResource OverlayDenseBrush}"
                    CornerRadius="4">
                    <FontIcon Glyph="&#xE78A;" Foreground="{ThemeResource OverlayForegroundBrush}" FontSize="14" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource OverlayForegroundBrush}"
                        Text="Drag to position zoom region"
                        FontSize="12" />
                    <Button
                        Content="Apply"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ZoomRegionApply_Click"
                        Padding="12,4" />
                    <Button
                        Content="Cancel"
                        Click="ZoomRegionCancel_Click"
                        Padding="12,4" />
                </StackPanel>
            </Grid>

            <!-- Text slide edit overlay (reposition + in-place editing) -->
            <Canvas x:Name="SlideEditCanvas" Visibility="Collapsed">
                <Border x:Name="SlideTextRegion"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1.5"
                        CornerRadius="2"
                        DoubleTapped="SlideTextRegion_DoubleTapped"
                        PointerEntered="SlideTextRegion_PointerEntered"
                        PointerExited="SlideTextRegion_PointerExited"
                        PointerPressed="SlideTextRegion_PointerPressed"
                        PointerMoved="SlideTextRegion_PointerMoved"
                        PointerReleased="SlideTextRegion_PointerReleased">
                    <Border.Background>
                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.06" />
                    </Border.Background>
                </Border>
                <TextBox x:Name="SlideEditBox"
                         Visibility="Collapsed"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         TextChanged="SlideEditBox_TextChanged"
                         KeyDown="SlideEditBox_KeyDown"
                         LostFocus="SlideEditBox_LostFocus" />
            </Canvas>
        </Grid>

            <!-- Adobe-style collapsible properties pane (scene / text slide / mouse / video) -->
            <controls:PropertiesPane
                x:Name="PropertiesPanel"
                Grid.Column="1" />
        </Grid>

        <!-- Editor toolbar -->
        <Grid
            Grid.Row="2"
            Padding="8,4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Undo / Redo buttons -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.UndoCommand}"
                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.UndoTooltip, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.RedoCommand}"
                    IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.RedoTooltip, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                </Button>

                <AppBarSeparator />

                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.SplitAtPlayheadCommand}"
                    ToolTipService.ToolTip="Split at Playhead (S)">
                    <PathIcon Data="M 4,2 C 2.5,2 2,3.5 2,5 L 2,15 C 2,16.5 2.5,18 4,18 L 7,18 L 7,16 L 4.5,16 C 3.7,16 4,15 4,14.5 L 4,5.5 C 4,5 3.7,4 4.5,4 L 7,4 L 7,2 Z  M 16,2 C 17.5,2 18,3.5 18,5 L 18,15 C 18,16.5 17.5,18 16,18 L 13,18 L 13,16 L 15.5,16 C 16.3,16 16,15 16,14.5 L 16,5.5 C 16,5 16.3,4 15.5,4 L 13,4 L 13,2 Z  M 9.5,1 L 10.5,1 L 10.5,19 L 9.5,19 Z" />
                </Button>
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                    ToolTipService.ToolTip="Delete Segment (Del)">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.CutSelectionCommand}"
                    ToolTipService.ToolTip="Cut Selection (Ctrl+X)">
                    <FontIcon FontSize="16" Glyph="&#xE8C6;" />
                </Button>

                <AppBarSeparator />

                <DropDownButton
                    Padding="8,6"
                    ToolTipService.ToolTip="Insert a segment into the timeline">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Insert" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem
                                Text="Text Slide"
                                Click="AddTextSlide_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8D2;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="Record More"
                                Click="RecordMore_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA3A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <ComboBox
                    x:Name="SpeedComboBox"
                    Width="100"
                    SelectedIndex="2"
                    SelectionChanged="SpeedComboBox_SelectionChanged"
                    ToolTipService.ToolTip="Playback speed"
                    Visibility="Collapsed">
                    <ComboBoxItem Content="0.25x" Tag="0.25" />
                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                    <ComboBoxItem Content="1x" Tag="1" />
                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                    <ComboBoxItem Content="2x" Tag="2" />
                    <ComboBoxItem Content="4x" Tag="4" />
                </ComboBox>
            </StackPanel>

            <!-- Speed controls -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">

                <!-- Zoom segment controls -->
                <StackPanel
                    x:Name="ZoomSegmentPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <TextBlock VerticalAlignment="Center" Text="Zoom:" FontWeight="SemiBold" />
                    <ComboBox
                        x:Name="ZoomLevelCombo"
                        Width="80"
                        Height="40"
                        IsEditable="True"
                        SelectedIndex="2"
                        SelectionChanged="ZoomLevelCombo_SelectionChanged"
                        TextSubmitted="ZoomLevelCombo_TextSubmitted"
                        ToolTipService.ToolTip="Zoom level for selected segment">
                        <ComboBoxItem Content="1x" Tag="1" />
                        <ComboBoxItem Content="1.5x" Tag="1.5" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="2.5x" Tag="2.5" />
                        <ComboBoxItem Content="3x" Tag="3" />
                        <ComboBoxItem Content="4x" Tag="4" />
                    </ComboBox>
                    <Button
                        Height="40"
                        Padding="8,6"
                        Click="EditZoomRegion_Click"
                        ToolTipService.ToolTip="Position the zoom region visually">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="14" Glyph="&#xE78A;" />
                            <TextBlock Text="Edit Region" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="40"
                        Padding="8,6"
                        Click="RemoveZoomSegment_Click"
                        ToolTipService.ToolTip="Remove selected zoom segment">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>

                <!-- Default zoom controls hint (no segment selected) -->
                <TextBlock
                    x:Name="ZoomHintText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Drag on zoom track to add segment"
                    FontStyle="Italic" />

                <Button
                    x:Name="OpenProjectButton"
                    Height="40"
                    Padding="8,6"
                    Click="OpenProject_Click"
                    ToolTipService.ToolTip="Open a saved .musio project">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SaveProjectButton"
                    Height="40"
                    Padding="8,6"
                    Click="SaveProject_Click"
                    ToolTipService.ToolTip="Save this project as a single .musio file you can reopen and keep editing">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ExportButton"
                    Height="40"
                    Padding="8,6"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Export recording">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE898;" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ExportFlyout" Placement="Top">
                            <StackPanel Width="280" Spacing="16" Padding="8">
                                <!-- Exporting state -->
                                <StackPanel
                                    x:Name="ExportingPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Visible">
                                    <ProgressRing
                                        Width="80"
                                        Height="80"
                                        IsIndeterminate="False"
                                        Maximum="100"
                                        Value="{x:Bind ExportVM.ProgressPercent, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="14"
                                        TextAlignment="Center"
                                        Text="Exporting…" />
                                    <Button
                                        HorizontalAlignment="Center"
                                        Click="CancelExport_Click"
                                        Content="Cancel" />
                                </StackPanel>

                                <!-- Success state -->
                                <StackPanel
                                    x:Name="ExportedPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="40"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE73E;" />
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        Text="Exported!" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Text="{x:Bind ExportVM.ExportedFilePath, Mode=OneWay}" />
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Click="OpenFileLocation_Click"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Content="Open file location" />
                                        <Button
                                            Click="CloseFlyout_Click"
                                            Content="Close" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Error state -->
                                <StackPanel
                                    x:Name="ExportErrorPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="40"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Glyph="&#xE783;" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        Text="Export Failed" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Text="{x:Bind ExportVM.ErrorMessage, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Center"
                                        Click="CloseFlyout_Click"
                                        Content="Close" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Timeline editor control -->
        <controls:TimelineControl
            x:Name="Timeline"
            Grid.Row="3"
            Height="280"
            Margin="0,4,0,0"
            Model="{x:Bind ViewModel.Model}" />

        <!-- TeachingTip for first-run editor hints -->
        <TeachingTip
            x:Name="EditorTip"
            Title="Editor Shortcuts"
            Subtitle="Use Ctrl+Z / Ctrl+Y to undo and redo edits. Drag the timeline to scrub through your recording."
            IsLightDismissEnabled="True"
            PreferredPlacement="Top" />
    </Grid>
</Page>
