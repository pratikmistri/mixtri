<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Musio_App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Musio_App.Controls"
    xmlns:conv="using:Musio_App.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:CheckedToBrushConverter x:Key="CheckedToBrush" />

        <!-- Crop-position cell: a flat fill-on-check RadioButton with no border or
             padding so 9 of them can tile into a single rectangle. -->
        <Style x:Key="CropCellRadioStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="CellRoot" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="UncheckedNormal" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CellRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CellRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="CellRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedNormal">
                                        <VisualState.Setters>
                                            <Setter Target="CellRoot.Background"
                                                    Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CellRoot.Background"
                                                    Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CellRoot.Background"
                                                    Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="CellRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aspect-ratio tile: bordered RadioButton hosting a proportional preview
             rectangle and label. Selected state lights up the border with the accent. -->
        <Style x:Key="AspectRatioTileStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="6,6,6,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TileRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="UncheckedNormal" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedNormal">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Z"
            Invoked="UndoAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Y"
            Invoked="RedoAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="S"
            Invoked="SplitAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Delete"
            Invoked="DeleteAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="X"
            Invoked="CutAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Space"
            Invoked="PlayPauseAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar for editor status -->
        <InfoBar
            x:Name="EditorInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Preview canvas with zoom region overlay -->
        <Grid Grid.Row="1">
            <controls:PreviewCanvas
                x:Name="Preview" />

            <!-- Webcam position overlay (drag to move) -->
            <Canvas x:Name="WebcamOverlayCanvas"
                    SizeChanged="WebcamOverlay_SizeChanged">
                <Border x:Name="WebcamOverlayRect"
                        Background="Transparent"
                        Visibility="Collapsed"
                        PointerPressed="WebcamOverlay_PointerPressed"
                        PointerMoved="WebcamOverlay_PointerMoved"
                        PointerReleased="WebcamOverlay_PointerReleased" />
            </Canvas>

            <!-- Zoom region edit overlay -->
            <Grid x:Name="ZoomRegionOverlay" Visibility="Collapsed">
                <Canvas x:Name="ZoomRegionCanvas"
                        Background="Transparent"
                        PointerPressed="ZoomRegionCanvas_PointerPressed"
                        PointerMoved="ZoomRegionCanvas_PointerMoved"
                        PointerReleased="ZoomRegionCanvas_PointerReleased"
                        SizeChanged="ZoomRegionCanvas_SizeChanged">
                    <Rectangle x:Name="DimTop" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="DimBottom" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="DimLeft" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="DimRight" Fill="{ThemeResource OverlayDimBrush}" IsHitTestVisible="False" />
                    <Rectangle x:Name="ZoomRegionRect"
                               Stroke="{ThemeResource OverlayForegroundBrush}" StrokeThickness="1"
                               StrokeDashArray="6,3"
                               Fill="Transparent"
                               IsHitTestVisible="False" />
                    <Line x:Name="SnapGuideV" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3,3"
                          Visibility="Collapsed" IsHitTestVisible="False" />
                    <Line x:Name="SnapGuideH" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3,3"
                          Visibility="Collapsed" IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleTL" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleTR" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleBL" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                    <Rectangle x:Name="HandleBR" Width="10" Height="10"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False" />
                </Canvas>

                <StackPanel
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Padding="12,8"
                    Margin="0,8,0,0"
                    Background="{ThemeResource OverlayDenseBrush}"
                    CornerRadius="4">
                    <FontIcon Glyph="&#xE78A;" Foreground="{ThemeResource OverlayForegroundBrush}" FontSize="14" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource OverlayForegroundBrush}"
                        Text="Drag to position zoom region"
                        FontSize="12" />
                    <Button
                        Content="Apply"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ZoomRegionApply_Click"
                        Padding="12,4" />
                    <Button
                        Content="Cancel"
                        Click="ZoomRegionCancel_Click"
                        Padding="12,4" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Editor toolbar -->
        <Grid
            Grid.Row="2"
            Padding="8,4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Undo / Redo buttons -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.UndoCommand}"
                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.UndoTooltip, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.RedoCommand}"
                    IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.RedoTooltip, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                </Button>

                <AppBarSeparator />

                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.SplitAtPlayheadCommand}"
                    ToolTipService.ToolTip="Split at Playhead (S)">
                    <PathIcon Data="M 4,2 C 2.5,2 2,3.5 2,5 L 2,15 C 2,16.5 2.5,18 4,18 L 7,18 L 7,16 L 4.5,16 C 3.7,16 4,15 4,14.5 L 4,5.5 C 4,5 3.7,4 4.5,4 L 7,4 L 7,2 Z  M 16,2 C 17.5,2 18,3.5 18,5 L 18,15 C 18,16.5 17.5,18 16,18 L 13,18 L 13,16 L 15.5,16 C 16.3,16 16,15 16,14.5 L 16,5.5 C 16,5 16.3,4 15.5,4 L 13,4 L 13,2 Z  M 9.5,1 L 10.5,1 L 10.5,19 L 9.5,19 Z" />
                </Button>
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                    ToolTipService.ToolTip="Delete Segment (Del)">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>
                <Button
                    Padding="8,6"
                    Command="{x:Bind ViewModel.CutSelectionCommand}"
                    ToolTipService.ToolTip="Cut Selection (Ctrl+X)">
                    <FontIcon FontSize="16" Glyph="&#xE8C6;" />
                </Button>

                <ComboBox
                    x:Name="SpeedComboBox"
                    Width="100"
                    SelectedIndex="2"
                    SelectionChanged="SpeedComboBox_SelectionChanged"
                    ToolTipService.ToolTip="Playback speed"
                    Visibility="Collapsed">
                    <ComboBoxItem Content="0.25x" Tag="0.25" />
                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                    <ComboBoxItem Content="1x" Tag="1" />
                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                    <ComboBoxItem Content="2x" Tag="2" />
                    <ComboBoxItem Content="4x" Tag="4" />
                </ComboBox>
            </StackPanel>

            <!-- Speed controls -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">

                <!-- Zoom segment controls -->
                <StackPanel
                    x:Name="ZoomSegmentPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <TextBlock VerticalAlignment="Center" Text="Zoom:" FontWeight="SemiBold" />
                    <ComboBox
                        x:Name="ZoomLevelCombo"
                        Width="80"
                        IsEditable="True"
                        SelectedIndex="2"
                        SelectionChanged="ZoomLevelCombo_SelectionChanged"
                        TextSubmitted="ZoomLevelCombo_TextSubmitted"
                        ToolTipService.ToolTip="Zoom level for selected segment">
                        <ComboBoxItem Content="1x" Tag="1" />
                        <ComboBoxItem Content="1.5x" Tag="1.5" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="2.5x" Tag="2.5" />
                        <ComboBoxItem Content="3x" Tag="3" />
                        <ComboBoxItem Content="4x" Tag="4" />
                    </ComboBox>
                    <Button
                        Padding="8,6"
                        Click="EditZoomRegion_Click"
                        ToolTipService.ToolTip="Position the zoom region visually">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="14" Glyph="&#xE78A;" />
                            <TextBlock Text="Edit Region" />
                        </StackPanel>
                    </Button>
                    <Button
                        Padding="8,6"
                        Click="RemoveZoomSegment_Click"
                        ToolTipService.ToolTip="Remove selected zoom segment">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>

                <!-- Default zoom controls (no segment selected) -->
                <TextBlock
                    x:Name="ZoomHintText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Drag on zoom track to add segment"
                    FontStyle="Italic" />

                <!-- Background style controls -->
                <AppBarSeparator x:Name="StyleSeparator" />
                <Button
                    x:Name="StyleButton"
                    Padding="8,6"
                    ToolTipService.ToolTip="Frame style (aspect ratio, background, padding)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE790;" />
                        <TextBlock Text="Frame style" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="StyleFlyout" Placement="Top">
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="280" Spacing="14" Padding="4">
                                <TextBlock Text="Frame Style" FontWeight="SemiBold" FontSize="14" />

                                <!-- Aspect ratio grid: tile radios showing a proportional preview + label -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Aspect ratio" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <RadioButton x:Name="RatioAuto" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="0" Grid.Column="0"
                                                     Tag="Auto" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="34" Height="24"
                                                            Background="{Binding IsChecked, ElementName=RatioAuto, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=RatioAuto, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="A" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding IsChecked, ElementName=RatioAuto, Converter={StaticResource CheckedToBrush}, ConverterParameter=Glyph}" />
                                                </Grid>
                                                <TextBlock Text="Auto" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="Ratio16x9" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="0" Grid.Column="1"
                                                     Tag="Landscape16x9" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="36" Height="20"
                                                            Background="{Binding IsChecked, ElementName=Ratio16x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=Ratio16x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1.5" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="16:9" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="Ratio9x16" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="0" Grid.Column="2"
                                                     Tag="Portrait9x16" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="14" Height="25"
                                                            Background="{Binding IsChecked, ElementName=Ratio9x16, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=Ratio9x16, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1.5" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="9:16" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="Ratio1x1" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="0" Grid.Column="3"
                                                     Tag="Square1x1" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="24" Height="24"
                                                            Background="{Binding IsChecked, ElementName=Ratio1x1, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=Ratio1x1, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1.5" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="1:1" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="Ratio4x5" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="1" Grid.Column="0"
                                                     Tag="Instagram4x5" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="20" Height="25"
                                                            Background="{Binding IsChecked, ElementName=Ratio4x5, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=Ratio4x5, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1.5" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="4:5" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="Ratio4x3" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="1" Grid.Column="1"
                                                     Tag="Classic4x3" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="32" Height="24"
                                                            Background="{Binding IsChecked, ElementName=Ratio4x3, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=Ratio4x3, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1.5" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="4:3" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="Ratio3x4" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="1" Grid.Column="2"
                                                     Tag="Tall3x4" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="18" Height="24"
                                                            Background="{Binding IsChecked, ElementName=Ratio3x4, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=Ratio3x4, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1.5" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="3:4" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="Ratio21x9" GroupName="AspectRatioGrid"
                                                     Style="{StaticResource AspectRatioTileStyle}"
                                                     Grid.Row="1" Grid.Column="3"
                                                     Tag="Cinematic21x9" Checked="AspectRatioOption_Checked">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Grid Width="36" Height="26">
                                                    <Border Width="36" Height="15"
                                                            Background="{Binding IsChecked, ElementName=Ratio21x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                                            BorderBrush="{Binding IsChecked, ElementName=Ratio21x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                                            BorderThickness="1.5" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="21:9" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>

                                <!-- Fit mode: binary choice rendered as a segmented control -->
                                <StackPanel x:Name="FitModePanel" Spacing="6">
                                    <TextBlock Text="Fit" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ctk:Segmented x:Name="FitModeSegmented"
                                                   HorizontalAlignment="Stretch"
                                                   SelectionChanged="FitModeSegmented_SelectionChanged">
                                        <ctk:SegmentedItem Content="Cover" Tag="Cover"
                                                           ToolTipService.ToolTip="Fill the canvas; source is cropped to fit" />
                                        <ctk:SegmentedItem Content="Contain" Tag="Contain"
                                                           ToolTipService.ToolTip="Fit entire source; gap filled with background" />
                                    </ctk:Segmented>
                                </StackPanel>

                                <!-- Zoom scope: binary choice rendered as a segmented control -->
                                <StackPanel x:Name="ZoomScopePanel" Spacing="6">
                                    <TextBlock Text="Zoom scope" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ctk:Segmented x:Name="ZoomScopeSegmented"
                                                   HorizontalAlignment="Stretch"
                                                   SelectionChanged="ZoomScopeSegmented_SelectionChanged">
                                        <ctk:SegmentedItem Content="Whole frame" Tag="Frame"
                                                           ToolTipService.ToolTip="Zoom region spans the entire visible canvas, including background, letterbox and padding." />
                                        <ctk:SegmentedItem Content="Source only" Tag="Source"
                                                           ToolTipService.ToolTip="Zoom region is constrained to the captured source; background, letterbox and padding stay fixed." />
                                    </ctk:Segmented>
                                </StackPanel>

                                <!-- Crop position picker: single rectangle subdivided into 9 cells.
                                     The selected cell fills with the accent color. -->
                                <StackPanel x:Name="CropAnchorPanel" Spacing="6">
                                    <TextBlock Text="Crop position" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border HorizontalAlignment="Left"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid x:Name="CropAnchorGrid"
                                              AutomationProperties.Name="Crop anchor position"
                                              AutomationProperties.HelpText="Choose where the crop is anchored within the source frame">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="1" />
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="1" />
                                                <RowDefinition Height="34" />
                                            </Grid.RowDefinitions>

                                            <!-- Vertical dividers -->
                                            <Border Grid.Column="1" Grid.RowSpan="5"
                                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Border Grid.Column="3" Grid.RowSpan="5"
                                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <!-- Horizontal dividers -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="5"
                                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Border Grid.Row="3" Grid.ColumnSpan="5"
                                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                            <RadioButton GroupName="CropAnchor" Tag="0,0"
                                                         AutomationProperties.Name="Top left"
                                                         ToolTipService.ToolTip="Top left"
                                                         Grid.Row="0" Grid.Column="0"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton GroupName="CropAnchor" Tag="0.5,0"
                                                         AutomationProperties.Name="Top center"
                                                         ToolTipService.ToolTip="Top center"
                                                         Grid.Row="0" Grid.Column="2"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton GroupName="CropAnchor" Tag="1,0"
                                                         AutomationProperties.Name="Top right"
                                                         ToolTipService.ToolTip="Top right"
                                                         Grid.Row="0" Grid.Column="4"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton GroupName="CropAnchor" Tag="0,0.5"
                                                         AutomationProperties.Name="Middle left"
                                                         ToolTipService.ToolTip="Middle left"
                                                         Grid.Row="2" Grid.Column="0"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton x:Name="CropAnchorCenter" GroupName="CropAnchor" Tag="0.5,0.5"
                                                         AutomationProperties.Name="Center"
                                                         ToolTipService.ToolTip="Center"
                                                         Grid.Row="2" Grid.Column="2" IsChecked="True"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton GroupName="CropAnchor" Tag="1,0.5"
                                                         AutomationProperties.Name="Middle right"
                                                         ToolTipService.ToolTip="Middle right"
                                                         Grid.Row="2" Grid.Column="4"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton GroupName="CropAnchor" Tag="0,1"
                                                         AutomationProperties.Name="Bottom left"
                                                         ToolTipService.ToolTip="Bottom left"
                                                         Grid.Row="4" Grid.Column="0"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton GroupName="CropAnchor" Tag="0.5,1"
                                                         AutomationProperties.Name="Bottom center"
                                                         ToolTipService.ToolTip="Bottom center"
                                                         Grid.Row="4" Grid.Column="2"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                            <RadioButton GroupName="CropAnchor" Tag="1,1"
                                                         AutomationProperties.Name="Bottom right"
                                                         ToolTipService.ToolTip="Bottom right"
                                                         Grid.Row="4" Grid.Column="4"
                                                         Style="{StaticResource CropCellRadioStyle}"
                                                         Checked="CropAnchor_Checked" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <TextBlock Text="Background" FontWeight="SemiBold" FontSize="13" />

                                <!-- Preset picker -->
                                <ComboBox
                                    x:Name="PresetCombo"
                                    Header="Preset"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Name"
                                    SelectionChanged="PresetCombo_SelectionChanged" />

                                <!-- Background type -->
                                <ComboBox
                                    x:Name="BgTypeCombo"
                                    Header="Background"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="BgTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Solid Color" Tag="SolidColor" />
                                    <ComboBoxItem Content="Gradient" Tag="Gradient" />
                                    <ComboBoxItem Content="Wallpaper" Tag="Image" />
                                    <ComboBoxItem Content="Blur" Tag="Blur" />
                                </ComboBox>

                                <!-- Primary color -->
                                <StackPanel x:Name="ColorPanel" Spacing="4">
                                    <TextBlock Text="Color" FontSize="12" />
                                    <DropDownButton x:Name="BgColorButton" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border
                                                x:Name="BgColorSwatch"
                                                Width="20" Height="20"
                                                CornerRadius="4"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" />
                                            <TextBlock x:Name="BgColorText" Text="#1a1a2e" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    x:Name="BgColorPicker"
                                                    IsAlphaEnabled="False"
                                                    IsHexInputVisible="True"
                                                    ColorChanged="BgColorPicker_ColorChanged" />
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>

                                <!-- Gradient end color (only visible for Gradient type) -->
                                <StackPanel x:Name="GradientPanel" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="Gradient End Color" FontSize="12" />
                                    <DropDownButton x:Name="GradEndColorButton" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border
                                                x:Name="GradEndColorSwatch"
                                                Width="20" Height="20"
                                                CornerRadius="4"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" />
                                            <TextBlock x:Name="GradEndColorText" Text="#16213e" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    x:Name="GradEndColorPicker"
                                                    IsAlphaEnabled="False"
                                                    IsHexInputVisible="True"
                                                    ColorChanged="GradEndColorPicker_ColorChanged" />
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>

                                    <Slider
                                        x:Name="GradAngleSlider"
                                        Header="Gradient Angle"
                                        Minimum="0" Maximum="360"
                                        StepFrequency="5"
                                        ValueChanged="StyleSlider_ValueChanged" />
                                </StackPanel>

                                <!-- Wallpaper picker (only visible for Wallpaper/Image type) -->
                                <StackPanel x:Name="WallpaperPanel" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="Wallpaper" FontSize="12" />
                                    <GridView
                                        x:Name="WallpaperGrid"
                                        MaxHeight="180"
                                        SelectionMode="Single"
                                        SelectionChanged="WallpaperGrid_SelectionChanged" />
                                </StackPanel>

                                <!-- Padding -->
                                <Slider
                                    x:Name="PaddingSlider"
                                    Header="Padding"
                                    Minimum="0" Maximum="120"
                                    StepFrequency="4"
                                    ValueChanged="StyleSlider_ValueChanged" />

                                <!-- Corner radius -->
                                <Slider
                                    x:Name="CornerRadiusSlider"
                                    Header="Corner Radius"
                                    Minimum="0" Maximum="32"
                                    StepFrequency="2"
                                    ValueChanged="StyleSlider_ValueChanged" />

                                <!-- Shadow -->
                                <ToggleSwitch
                                    x:Name="ShadowToggle"
                                    Header="Shadow"
                                    Toggled="StyleToggle_Toggled" />

                                <!-- Border -->
                                <ToggleSwitch
                                    x:Name="BorderToggle"
                                    Header="Border"
                                    Toggled="StyleToggle_Toggled" />
                            </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Cursor style controls -->
                <AppBarSeparator x:Name="CursorSeparator" Visibility="Collapsed" />
                <Button
                    x:Name="CursorButton"
                    Padding="8,6"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Cursor settings">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE7C9;" />
                        <TextBlock Text="Cursor" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="CursorFlyout" Placement="Top">
                            <StackPanel Width="260" Spacing="16" Padding="4">
                                <TextBlock Text="Cursor" FontWeight="SemiBold" FontSize="14" />

                                <!-- Cursor type: Mouse / Touch -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Type" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <RadioButton
                                            x:Name="CursorTypeMouse"
                                            Content="Mouse"
                                            GroupName="CursorType"
                                            Checked="CursorType_Checked" />
                                        <RadioButton
                                            x:Name="CursorTypeTouch"
                                            Content="Touch"
                                            GroupName="CursorType"
                                            Checked="CursorType_Checked" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Size slider -->
                                <Slider
                                    x:Name="CursorSizeSlider"
                                    Header="Size"
                                    Minimum="1"
                                    Maximum="6"
                                    StepFrequency="0.25"
                                    ValueChanged="CursorSizeSlider_ValueChanged" />

                                <!-- Tilt toggle (mouse cursor only) -->
                                <ToggleSwitch
                                    x:Name="CursorTiltToggle"
                                    Header="Tilt"
                                    Toggled="CursorTiltToggle_Toggled" />

                                <!-- Color presets -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Color" FontSize="12" />
                                    <StackPanel x:Name="CursorColorPanel" Orientation="Horizontal" Spacing="8">
                                        <RadioButton GroupName="CursorColor" Tag="#FFFFFF" Checked="CursorColor_Checked" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="White">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Grid>
                                                        <Ellipse Width="28" Height="28" Fill="White" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                        <Ellipse x:Name="SelectionRing" Width="34" Height="34" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CheckStates">
                                                                <VisualState x:Name="Checked">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="SelectionRing.Visibility" Value="Visible" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Unchecked" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton GroupName="CursorColor" Tag="#000000" Checked="CursorColor_Checked" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Black">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Grid>
                                                        <Ellipse Width="28" Height="28" Fill="Black" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                        <Ellipse x:Name="SelectionRing" Width="34" Height="34" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CheckStates">
                                                                <VisualState x:Name="Checked">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="SelectionRing.Visibility" Value="Visible" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Unchecked" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton GroupName="CursorColor" Tag="#FFD600" Checked="CursorColor_Checked" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Yellow">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Grid>
                                                        <Ellipse Width="28" Height="28" Fill="#FFD600" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                        <Ellipse x:Name="SelectionRing" Width="34" Height="34" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CheckStates">
                                                                <VisualState x:Name="Checked">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="SelectionRing.Visibility" Value="Visible" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Unchecked" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton GroupName="CursorColor" Tag="#FF3B30" Checked="CursorColor_Checked" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Red">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Grid>
                                                        <Ellipse Width="28" Height="28" Fill="#FF3B30" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                        <Ellipse x:Name="SelectionRing" Width="34" Height="34" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CheckStates">
                                                                <VisualState x:Name="Checked">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="SelectionRing.Visibility" Value="Visible" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Unchecked" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton GroupName="CursorColor" Tag="#007AFF" Checked="CursorColor_Checked" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Blue">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Grid>
                                                        <Ellipse Width="28" Height="28" Fill="#007AFF" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                        <Ellipse x:Name="SelectionRing" Width="34" Height="34" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CheckStates">
                                                                <VisualState x:Name="Checked">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="SelectionRing.Visibility" Value="Visible" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Unchecked" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton GroupName="CursorColor" Tag="#34C759" Checked="CursorColor_Checked" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Green">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Grid>
                                                        <Ellipse Width="28" Height="28" Fill="#34C759" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                        <Ellipse x:Name="SelectionRing" Width="34" Height="34" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CheckStates">
                                                                <VisualState x:Name="Checked">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="SelectionRing.Visibility" Value="Visible" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Unchecked" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Webcam overlay settings (visible when webcam overlay is active) -->
                <AppBarSeparator x:Name="WebcamShapeSeparator" Visibility="Collapsed" />
                <Button
                    x:Name="WebcamShapeButton"
                    Padding="8,6"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Webcam overlay settings">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE714;" />
                        <TextBlock Text="Camera" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <StackPanel Width="260" Spacing="12" Padding="4">
                                <TextBlock Text="Camera Overlay" FontWeight="SemiBold" FontSize="14" />

                                <!-- Shape -->
                                <ComboBox
                                    x:Name="WebcamShapeCombo"
                                    Header="Shape"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="WebcamShapeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Circle" Tag="Circle" />
                                    <ComboBoxItem Content="Square" Tag="RoundedRect" />
                                </ComboBox>

                                <!-- Border width -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Border Thickness" />
                                    <Slider
                                        x:Name="WebcamBorderSlider"
                                        Minimum="0"
                                        Maximum="20"
                                        StepFrequency="1"
                                        Value="8"
                                        ValueChanged="WebcamBorderSlider_ValueChanged" />
                                </StackPanel>

                                <!-- Mirror -->
                                <ToggleSwitch
                                    x:Name="WebcamMirrorToggle"
                                    Header="Mirror"
                                    Toggled="WebcamMirrorToggle_Toggled" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <AppBarSeparator />

                <Button
                    x:Name="ExportButton"
                    Padding="8,6"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Export recording">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE898;" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ExportFlyout" Placement="Top">
                            <StackPanel Width="280" Spacing="16" Padding="8">
                                <!-- Exporting state -->
                                <StackPanel
                                    x:Name="ExportingPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Visible">
                                    <ProgressRing
                                        Width="80"
                                        Height="80"
                                        IsIndeterminate="False"
                                        Maximum="100"
                                        Value="{x:Bind ExportVM.ProgressPercent, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="14"
                                        TextAlignment="Center"
                                        Text="Exporting…" />
                                    <Button
                                        HorizontalAlignment="Center"
                                        Click="CancelExport_Click"
                                        Content="Cancel" />
                                </StackPanel>

                                <!-- Success state -->
                                <StackPanel
                                    x:Name="ExportedPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="40"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE73E;" />
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        Text="Exported!" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Text="{x:Bind ExportVM.ExportedFilePath, Mode=OneWay}" />
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Click="OpenFileLocation_Click"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Content="Open file location" />
                                        <Button
                                            Click="CloseFlyout_Click"
                                            Content="Close" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Error state -->
                                <StackPanel
                                    x:Name="ExportErrorPanel"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="40"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Glyph="&#xE783;" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        Text="Export Failed" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Text="{x:Bind ExportVM.ErrorMessage, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Center"
                                        Click="CloseFlyout_Click"
                                        Content="Close" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Timeline editor control -->
        <controls:TimelineControl
            x:Name="Timeline"
            Grid.Row="3"
            Height="280"
            Margin="0,4,0,0"
            Model="{x:Bind ViewModel.Model}" />

        <!-- TeachingTip for first-run editor hints -->
        <TeachingTip
            x:Name="EditorTip"
            Title="Editor Shortcuts"
            Subtitle="Use Ctrl+Z / Ctrl+Y to undo and redo edits. Drag the timeline to scrub through your recording."
            IsLightDismissEnabled="True"
            PreferredPlacement="Top" />
    </Grid>
</Page>
