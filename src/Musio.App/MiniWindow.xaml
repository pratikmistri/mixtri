<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Musio_App.MiniWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Musio_App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Musio Mini"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" CornerRadius="14" Padding="4">
        <!-- WinUI 3 has no Window.Resources, so window-scoped resources live on
             the root Grid. -->
        <Grid.Resources>
            <Style x:Key="GripDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="2" />
                <Setter Property="Height" Value="2" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
        </Grid.Resources>

        <StackPanel Spacing="0" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <!-- Drag handle: the window is frameless, so this is the only region
                     handed to SetTitleBar for moving it around. Drawn as a 2x3 dot
                     grid rather than a glyph so it reads as a tall vertical grabber
                     and takes only the width the dots actually need. -->
                <Border
                    x:Name="DragGrip"
                    Width="14"
                    Height="36"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    ToolTipService.ToolTip="Drag to move"
                    AutomationProperties.Name="Drag to move">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Ellipse Grid.Row="0" Grid.Column="0" Style="{StaticResource GripDotStyle}" />
                        <Ellipse Grid.Row="0" Grid.Column="1" Style="{StaticResource GripDotStyle}" />
                        <Ellipse Grid.Row="1" Grid.Column="0" Style="{StaticResource GripDotStyle}" />
                        <Ellipse Grid.Row="1" Grid.Column="1" Style="{StaticResource GripDotStyle}" />
                        <Ellipse Grid.Row="2" Grid.Column="0" Style="{StaticResource GripDotStyle}" />
                        <Ellipse Grid.Row="2" Grid.Column="1" Style="{StaticResource GripDotStyle}" />
                    </Grid>
                </Border>

                <controls:RecordToolbarControl
                    x:Name="Toolbar"
                    ShowInlineRecordButton="True"
                    ShowExpandButton="True"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="HideButton"
                    Click="HideButton_Click"
                    Width="32" Height="32" Padding="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Hide to the system tray (Esc)"
                    AutomationProperties.Name="Hide to system tray">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- Errors and transient messages only. Selection details (window name,
                 region coordinates) are deliberately not surfaced here — Mini mode
                 stays compact and the full Record page shows them instead. -->
            <TextBlock
                x:Name="StatusText"
                Visibility="Collapsed"
                Margin="14,0,14,6"
                MaxWidth="420"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
