<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.MiniSetupControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    TabFocusNavigation="Cycle"
    AutomationProperties.Name="Musio Mini"
    AutomationProperties.HelpText="Compact toolbar for choosing what to record"
    mc:Ignorable="d">

    <Border
        x:Name="ToolbarBorder"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="12"
        Padding="14,6,14,6">
        <Border.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="30" />
            </TransitionCollection>
        </Border.Transitions>

        <StackPanel x:Name="ToolbarContentPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- Options section (disabled during recording) -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                IsHitTestVisible="{x:Bind InvertBool(ViewModel.IsRecording), Mode=OneWay}"
                Opacity="{x:Bind RecordingOpacity(ViewModel.IsRecording), Mode=OneWay}">

                <!-- Capture Mode -->
                <ctk:Segmented
                    x:Name="CaptureModeSelector"
                    Height="36"
                    IsTabStop="True"
                    TabIndex="0"
                    AutomationProperties.Name="Capture mode"
                    AutomationProperties.HelpText="Choose region, window, or full screen recording"
                    SelectionChanged="CaptureModeSelector_SelectionChanged">
                    <ctk:Segmented.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="SegmentedPillBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="SegmentedPillBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="SegmentedPillBackgroundPressed" Color="Transparent" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="SegmentedPillBackground" Color="{StaticResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="SegmentedPillBackgroundPointerOver" Color="{StaticResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="SegmentedPillBackgroundPressed" Color="{StaticResource SystemColorHighlightColor}" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </ctk:Segmented.Resources>
                    <ctk:SegmentedItem Content="Full Screen" Tag="FullScreen" IsTabStop="True" TabIndex="0" AutomationProperties.Name="Full screen" Tapped="SegmentedItem_Tapped">
                        <ctk:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE740;" />
                        </ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                    <ctk:SegmentedItem Content="Window" Tag="Window" IsTabStop="True" TabIndex="1" AutomationProperties.Name="Window" Tapped="SegmentedItem_Tapped">
                        <ctk:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE737;" />
                        </ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                    <ctk:SegmentedItem Content="Region" Tag="CustomRegion" IsTabStop="True" TabIndex="2" AutomationProperties.Name="Region" Tapped="SegmentedItem_Tapped">
                        <ctk:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE7A8;" />
                        </ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                </ctk:Segmented>

                <!-- The old "Select Region" / "Select Window" inline buttons
                     were removed; selecting the corresponding tab now auto-
                     launches the picker, which is the only entry point. -->

                <AppBarSeparator />

                <!-- Audio & Camera toggles -->
                <ToggleButton
                    IsChecked="{x:Bind ViewModel.IsMicEnabled, Mode=TwoWay}"
                    ToolTipService.ToolTip="Microphone"
                    IsTabStop="True"
                    TabIndex="4"
                    AutomationProperties.Name="Microphone"
                    AutomationProperties.HelpText="Turn microphone recording on or off"
                    VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0">
                    <FontIcon Glyph="&#xE720;" FontSize="14" />
                </ToggleButton>
                <ToggleButton
                    IsChecked="{x:Bind ViewModel.IsSystemAudioEnabled, Mode=TwoWay}"
                    ToolTipService.ToolTip="System Audio"
                    IsTabStop="True"
                    TabIndex="5"
                    AutomationProperties.Name="System audio"
                    AutomationProperties.HelpText="Turn system audio recording on or off"
                    VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0">
                    <FontIcon Glyph="&#xE767;" FontSize="14" />
                </ToggleButton>
                <ToggleButton
                    IsChecked="{x:Bind ViewModel.IsWebcamEnabled, Mode=TwoWay}"
                    ToolTipService.ToolTip="Camera"
                    IsTabStop="True"
                    TabIndex="6"
                    AutomationProperties.Name="Camera"
                    AutomationProperties.HelpText="Turn camera recording on or off"
                    VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0">
                    <FontIcon Glyph="&#xE714;" FontSize="14" />
                </ToggleButton>
            </StackPanel>

            <AppBarSeparator x:Name="RecordSeparator" Visibility="{x:Bind ShowInlineRecordVisibility(ShowInlineRecordButton), Mode=OneWay}" />

            <!-- Compact inline Record button (visible only when ShowInlineRecordButton=true AND not recording) -->
            <Button
                x:Name="StartRecordButton"
                Click="StartRecordButton_Click"
                IsTabStop="True"
                TabIndex="7"
                Height="36"
                Padding="14,0"
                CornerRadius="18"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center"
                Visibility="{x:Bind InlineRecordVisibility(ShowInlineRecordButton, ViewModel.IsRecording), Mode=OneWay}"
                ToolTipService.ToolTip="Start recording (Ctrl+Shift+R)"
                AutomationProperties.Name="Record"
                AutomationProperties.HelpText="Start recording with the selected capture mode">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE7C8;" />
                    <TextBlock Text="Record" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Compact inline Stop + elapsed-time (visible only when ShowInlineRecordButton=true AND recording) -->
            <StackPanel
                x:Name="StopRecordPanel"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="{x:Bind InlineStopVisibility(ShowInlineRecordButton, ViewModel.IsRecording), Mode=OneWay}">
                <Button
                    x:Name="StopRecordButton"
                    IsTabStop="True"
                    TabIndex="7"
                    Height="36"
                    Width="36"
                    Padding="0"
                    CornerRadius="18"
                    Command="{x:Bind ViewModel.StopRecordingCommand}"
                    ToolTipService.ToolTip="Stop recording"
                    AutomationProperties.Name="Stop recording">
                    <FontIcon FontSize="14" Foreground="Red" Glyph="&#xE71A;" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="Red"
                    Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay}" />
            </StackPanel>

            <!-- Expand-to-Full button. Hidden by default; AppShellWindow flips
                 IsExpandButtonVisible when this control is the active state.
                 IsEnabled is set programmatically (see UpdateExpandEnabled in
                 code-behind) — x:Bind on a function with nested ViewModel
                 paths against a non-DP ViewModel getter does not reliably
                 re-subscribe in WinUI 3. -->
            <Button
                x:Name="ExpandButton"
                Visibility="{x:Bind BoolToVisibility(IsExpandButtonVisible), Mode=OneWay}"
                Click="ExpandButton_Click"
                IsTabStop="True"
                TabIndex="8"
                Width="36" Height="36" Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Expand to full app"
                AutomationProperties.Name="Expand to full app"
                AutomationProperties.HelpText="Open the full Musio app">
                <FontIcon Glyph="&#xE740;" FontSize="14" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
