<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.PreviewCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="PreviewRoot"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        PointerEntered="PreviewRoot_PointerEntered"
        PointerExited="PreviewRoot_PointerExited">
        <canvas:CanvasControl
            x:Name="PreviewSurface"
            Draw="PreviewSurface_Draw" />

        <!-- Playback controls overlay at bottom -->
        <StackPanel
            x:Name="PlaybackChrome"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Margin="0,0,0,12"
            Padding="8"
            Background="{ThemeResource OverlayDimBrush}"
            CornerRadius="999"
            Opacity="0"
            IsHitTestVisible="False"
            GotFocus="PlaybackChrome_GotFocus"
            LostFocus="PlaybackChrome_LostFocus">
            <Button
                x:Name="PlayPauseButton"
                Click="PlayPause_Click"
                Background="Transparent"
                BorderBrush="Transparent"
                Padding="8">
                <FontIcon
                    x:Name="PlayPauseIcon"
                    Glyph="&#xE768;"
                    Foreground="{ThemeResource OverlayForegroundBrush}"
                    FontSize="18" />
            </Button>
            <Border
                x:Name="QualityIndicator"
                Margin="2,0,8,0"
                Padding="7,3"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="3"
                Visibility="Collapsed"
                AutomationProperties.Name="Adaptive preview resolution"
                ToolTipService.ToolTip="Preview is downscaled for performance. Export remains full resolution.">
                <TextBlock
                    x:Name="QualityIndicatorText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource OverlayForegroundBrush}" />
            </Border>
            <TextBlock
                x:Name="TimeDisplay"
                VerticalAlignment="Center"
                Margin="12,0"
                Foreground="{ThemeResource OverlayForegroundBrush}"
                Text="0:00 / 0:00" />
        </StackPanel>
    </Grid>
</UserControl>
