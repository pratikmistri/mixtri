<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.WindowSelectorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerMoved="Grid_PointerMoved"
        PointerPressed="Grid_PointerPressed">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapePressed" />
        </Grid.KeyboardAccelerators>

        <!-- Desktop screenshot background -->
        <Image x:Name="ScreenshotImage"
               Stretch="Fill"
               IsHitTestVisible="False" />

        <!-- Visual overlay layer -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!-- Four dark mask rectangles forming the dim overlay around the highlighted window -->
            <Rectangle x:Name="TopMask" Fill="#99000000" />
            <Rectangle x:Name="BottomMask" Fill="#99000000" />
            <Rectangle x:Name="LeftMask" Fill="#99000000" />
            <Rectangle x:Name="RightMask" Fill="#99000000" />

            <!-- Highlight border around hovered window -->
            <Rectangle
                x:Name="HighlightRect"
                Fill="Transparent"
                Stroke="{ThemeResource OverlayForegroundBrush}"
                StrokeThickness="1"
                RadiusX="8"
                RadiusY="8"
                Visibility="Collapsed" />

            <!-- Window info label -->
            <Border
                x:Name="WindowInfoLabel"
                Background="{ThemeResource RegionLabelBackgroundBrush}"
                CornerRadius="4"
                Padding="10,6"
                Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="WindowTitleText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource OverlayForegroundBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="400" />
                    <TextBlock
                        x:Name="WindowProcessText"
                        FontSize="11"
                        Foreground="{ThemeResource OverlayForegroundBrush}"
                        Opacity="0.7" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Instruction text -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0"
            Padding="16,8"
            FontSize="16"
            Foreground="{ThemeResource OverlayForegroundBrush}"
            IsHitTestVisible="False"
            Text="Click a window to select it. Click Record on the toolbar to start. Esc to cancel." />
    </Grid>
</UserControl>
