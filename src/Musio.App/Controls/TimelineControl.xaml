<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        PointerWheelChanged="Grid_PointerWheelChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <!-- Track labels -->
            <ColumnDefinition Width="*" />
            <!-- Track canvases -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <!-- Time ruler -->
            <RowDefinition Height="60" />
            <!-- Video track -->
            <RowDefinition Height="40" />
            <!-- Cursor path track -->
            <RowDefinition Height="50" />
            <!-- Zoom segments track -->
            <RowDefinition Height="40" />
            <!-- System audio track -->
            <RowDefinition Height="40" />
            <!-- Mic audio track -->
        </Grid.RowDefinitions>

        <!-- Track labels -->
        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource TimelineRulerBackgroundBrush}" />
        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource TimelineTrackPrimaryBackgroundBrush}" Padding="4,0">
            <TextBlock Text="Video" Foreground="{ThemeResource TimelineTrackLabelForegroundBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource TimelineTrackSecondaryBackgroundBrush}" Padding="4,0">
            <TextBlock Text="Cursor" Foreground="{ThemeResource TimelineTrackLabelForegroundBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="3" Grid.Column="0" Background="{ThemeResource TimelineTrackSecondaryBackgroundBrush}" Padding="4,0">
            <TextBlock Text="Zoom" Foreground="{ThemeResource TimelineTrackLabelForegroundBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="4" Grid.Column="0" Background="{ThemeResource TimelineTrackSecondaryBackgroundBrush}" Padding="2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="AudioMuteButton"
                        Click="AudioMuteButton_Click"
                        Padding="2" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Mute/unmute system audio">
                    <FontIcon x:Name="AudioMuteIcon" Glyph="&#xE767;" FontSize="12"
                              Foreground="{ThemeResource TimelineTrackLabelForegroundBrush}" />
                </Button>
                <TextBlock Text="Audio" Foreground="{ThemeResource TimelineTrackLabelForegroundBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border Grid.Row="5" Grid.Column="0" Background="{ThemeResource TimelineTrackSecondaryBackgroundBrush}" Padding="2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="MicMuteButton"
                        Click="MicMuteButton_Click"
                        Padding="2" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Mute/unmute microphone">
                    <FontIcon x:Name="MicMuteIcon" Glyph="&#xE767;" FontSize="12"
                              Foreground="{ThemeResource TimelineTrackLabelForegroundBrush}" />
                </Button>
                <TextBlock Text="Mic" Foreground="{ThemeResource TimelineTrackLabelForegroundBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Canvases -->
        <canvas:CanvasControl
            x:Name="TimeRulerCanvas"
            Grid.Row="0"
            Grid.Column="1"
            Draw="TimeRulerCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="VideoTrackCanvas"
            Grid.Row="1"
            Grid.Column="1"
            Draw="VideoTrackCanvas_Draw"
            PointerMoved="VideoTrack_PointerMoved"
            PointerPressed="VideoTrack_PointerPressed"
            PointerReleased="VideoTrack_PointerReleased" />

        <canvas:CanvasControl
            x:Name="CursorTrackCanvas"
            Grid.Row="2"
            Grid.Column="1"
            Draw="CursorTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="ZoomTrackCanvas"
            Grid.Row="3"
            Grid.Column="1"
            Draw="ZoomTrackCanvas_Draw"
            PointerPressed="ZoomTrack_PointerPressed"
            PointerMoved="ZoomTrack_PointerMoved"
            PointerReleased="ZoomTrack_PointerReleased"
            RightTapped="ZoomTrack_RightTapped" />

        <canvas:CanvasControl
            x:Name="AudioTrackCanvas"
            Grid.Row="4"
            Grid.Column="1"
            Draw="AudioTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="MicTrackCanvas"
            Grid.Row="5"
            Grid.Column="1"
            Draw="MicTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <!-- Playhead overlay line -->
        <Border
            x:Name="PlayheadLine"
            Grid.Row="0"
            Grid.RowSpan="6"
            Grid.Column="1"
            Width="2"
            HorizontalAlignment="Left"
            Background="{ThemeResource TimelinePlayheadOverlayBrush}"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
