<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        PointerWheelChanged="Grid_PointerWheelChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <!-- Track labels -->
            <ColumnDefinition Width="*" />
            <!-- Track canvases -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <!-- Time ruler -->
            <RowDefinition Height="80" />
            <!-- Video track -->
            <RowDefinition x:Name="CursorRow" Height="40" />
            <!-- Cursor path track -->
            <RowDefinition Height="50" />
            <!-- Zoom segments track -->
            <RowDefinition x:Name="CameraRow" Height="44" />
            <!-- Camera track -->
            <RowDefinition Height="44" />
            <!-- Text overlay track -->
            <RowDefinition x:Name="AudioRow" Height="40" />
            <!-- System audio track -->
            <RowDefinition x:Name="MicRow" Height="40" />
            <!-- Mic audio track -->
            <RowDefinition x:Name="VoiceOverRow" Height="0" />
            <!-- Inserted voice-over track -->
            <RowDefinition x:Name="MusicRow" Height="0" />
            <!-- Inserted music track -->
        </Grid.RowDefinitions>

        <!-- Track labels -->
        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="4,0">
            <TextBlock Text="Video" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="CursorTrackLabel" Grid.Row="2" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="4,0">
            <TextBlock Text="Cursor" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="3" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="4,0">
            <TextBlock Text="Zoom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="CameraTrackLabel" Grid.Row="4" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="4,0">
            <TextBlock Text="Camera" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="5" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="4,0">
            <TextBlock Text="Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="AudioTrackLabel" Grid.Row="6" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="AudioMuteButton"
                        Click="AudioMuteButton_Click"
                        Padding="2" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Mute/unmute system audio">
                    <FontIcon x:Name="AudioMuteIcon" Glyph="&#xE767;" FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <TextBlock Text="Audio" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border x:Name="MicTrackLabel" Grid.Row="7" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="MicMuteButton"
                        Click="MicMuteButton_Click"
                        Padding="2" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Mute/unmute microphone">
                    <FontIcon x:Name="MicMuteIcon" Glyph="&#xE767;" FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <TextBlock Text="Mic" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="VoiceOverTrackLabel" Grid.Row="8" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="2,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <FontIcon Glyph="&#xE720;" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Voice" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border x:Name="MusicTrackLabel" Grid.Row="9" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="2,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <FontIcon Glyph="&#xE8D6;" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Music" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Canvases -->
        <canvas:CanvasControl
            x:Name="TimeRulerCanvas"
            Grid.Row="0"
            Grid.Column="1"
            Draw="TimeRulerCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="VideoTrackCanvas"
            Grid.Row="1"
            Grid.Column="1"
            Draw="VideoTrackCanvas_Draw"
            PointerMoved="VideoTrack_PointerMoved"
            PointerExited="VideoTrack_PointerExited"
            PointerPressed="VideoTrack_PointerPressed"
            PointerReleased="VideoTrack_PointerReleased"
            RightTapped="VideoTrack_RightTapped" />

        <canvas:CanvasControl
            x:Name="CursorTrackCanvas"
            Grid.Row="2"
            Grid.Column="1"
            Draw="CursorTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="ZoomTrackCanvas"
            Grid.Row="3"
            Grid.Column="1"
            Draw="ZoomTrackCanvas_Draw"
            PointerPressed="ZoomTrack_PointerPressed"
            PointerMoved="ZoomTrack_PointerMoved"
            PointerReleased="ZoomTrack_PointerReleased"
            RightTapped="ZoomTrack_RightTapped" />

        <canvas:CanvasControl
            x:Name="CameraTrackCanvas"
            Grid.Row="4"
            Grid.Column="1"
            Draw="CameraTrackCanvas_Draw"
            PointerPressed="CameraTrack_PointerPressed"
            PointerMoved="CameraTrack_PointerMoved"
            PointerReleased="CameraTrack_PointerReleased"
            RightTapped="CameraTrack_RightTapped" />

        <canvas:CanvasControl
            x:Name="TextTrackCanvas"
            Grid.Row="5"
            Grid.Column="1"
            Draw="TextTrackCanvas_Draw"
            PointerPressed="TextTrack_PointerPressed"
            PointerMoved="TextTrack_PointerMoved"
            PointerReleased="TextTrack_PointerReleased"
            RightTapped="TextTrack_RightTapped"
            DoubleTapped="TextTrack_DoubleTapped"
            AutomationProperties.Name="Text overlay track" />

        <canvas:CanvasControl
            x:Name="AudioTrackCanvas"
            Grid.Row="6"
            Grid.Column="1"
            Draw="AudioTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="MicTrackCanvas"
            Grid.Row="7"
            Grid.Column="1"
            Draw="MicTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="VoiceOverTrackCanvas"
            Grid.Row="8"
            Grid.Column="1"
            Visibility="Collapsed"
            Draw="VoiceOverTrackCanvas_Draw"
            PointerPressed="AudioTrackLane_PointerPressed"
            PointerMoved="AudioTrackLane_PointerMoved"
            PointerReleased="AudioTrackLane_PointerReleased"
            RightTapped="AudioTrackLane_RightTapped"
            AutomationProperties.Name="Voice over track" />

        <canvas:CanvasControl
            x:Name="MusicTrackCanvas"
            Grid.Row="9"
            Grid.Column="1"
            Visibility="Collapsed"
            Draw="MusicTrackCanvas_Draw"
            PointerPressed="AudioTrackLane_PointerPressed"
            PointerMoved="AudioTrackLane_PointerMoved"
            PointerReleased="AudioTrackLane_PointerReleased"
            RightTapped="AudioTrackLane_RightTapped"
            AutomationProperties.Name="Music track" />

        <!-- Playhead overlay line — the only visual moved on a playback tick / scrub
             (see UpdatePlayheadVisual). Purely decorative: not hit-testable, and kept out
             of the automation tree so it isn't announced while playing. -->
        <Border
            x:Name="PlayheadLine"
            Grid.Row="0"
            Grid.RowSpan="10"
            Grid.Column="1"
            Width="2"
            HorizontalAlignment="Left"
            Background="{ThemeResource TimelinePlayheadOverlayBrush}"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
