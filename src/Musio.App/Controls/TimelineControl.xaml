<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        PointerWheelChanged="Grid_PointerWheelChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <!-- Track labels -->
            <ColumnDefinition Width="*" />
            <!-- Track canvases -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <!-- Time ruler -->
            <RowDefinition Height="60" />
            <!-- Video track -->
            <RowDefinition Height="40" />
            <!-- Cursor path track -->
            <RowDefinition Height="40" />
            <!-- Zoom keyframes track -->
            <RowDefinition Height="50" />
            <!-- Audio waveform track -->
        </Grid.RowDefinitions>

        <!-- Track labels -->
        <Border Grid.Row="0" Grid.Column="0" Background="#FF282828" />
        <Border Grid.Row="1" Grid.Column="0" Background="#FF1E1E1E" Padding="4,0">
            <TextBlock Text="Video" Foreground="#FFC8C8C8" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Background="#FF232323" Padding="4,0">
            <TextBlock Text="Cursor" Foreground="#FFC8C8C8" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="3" Grid.Column="0" Background="#FF232323" Padding="4,0">
            <TextBlock Text="Zoom" Foreground="#FFC8C8C8" FontSize="11" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="4" Grid.Column="0" Background="#FF232323" Padding="4,0">
            <TextBlock Text="Audio" Foreground="#FFC8C8C8" FontSize="11" VerticalAlignment="Center" />
        </Border>

        <!-- Canvases -->
        <canvas:CanvasControl
            x:Name="TimeRulerCanvas"
            Grid.Row="0"
            Grid.Column="1"
            Draw="TimeRulerCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="VideoTrackCanvas"
            Grid.Row="1"
            Grid.Column="1"
            Draw="VideoTrackCanvas_Draw"
            PointerMoved="VideoTrack_PointerMoved"
            PointerPressed="VideoTrack_PointerPressed"
            PointerReleased="VideoTrack_PointerReleased" />

        <canvas:CanvasControl
            x:Name="CursorTrackCanvas"
            Grid.Row="2"
            Grid.Column="1"
            Draw="CursorTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="ZoomTrackCanvas"
            Grid.Row="3"
            Grid.Column="1"
            Draw="ZoomTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <canvas:CanvasControl
            x:Name="AudioTrackCanvas"
            Grid.Row="4"
            Grid.Column="1"
            Draw="AudioTrackCanvas_Draw"
            PointerPressed="Track_PointerPressed" />

        <!-- Playhead overlay line -->
        <Border
            x:Name="PlayheadLine"
            Grid.Row="0"
            Grid.RowSpan="5"
            Grid.Column="1"
            Width="2"
            HorizontalAlignment="Left"
            Background="Red"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
