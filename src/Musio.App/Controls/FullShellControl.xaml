<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.FullShellControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Musio"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <!-- Title bar right-aligned content. Two mutually-exclusive
                 panels: the static Collapse-to-Mini button (default), and the
                 docked recording pill (shown only in FullRecording state). -->
            <TitleBar.Content>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Static state: just the Collapse-to-Mini button. -->
                    <Button
                        x:Name="CollapseButton"
                        Visibility="Collapsed"
                        Click="CollapseButton_Click"
                        Width="36" Height="32" Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Collapse to Mini"
                        AutomationProperties.Name="Collapse to Mini">
                        <FontIcon Glyph="&#xE73F;" FontSize="14" />
                    </Button>

                    <!-- FullRecording state: docked pill hosts the full
                         RecordingPillControl visuals (stopping ticker,
                         phrase animation, etc.) with the acrylic backdrop
                         neutralised since the title bar provides its own
                         (spec §4.3.1). The Collapse-to-Mini-Recording
                         button sits next to it because its semantics differ
                         from the pill's own expand-to-Full button. -->
                    <StackPanel
                        x:Name="DockedPillPanel"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        xmlns:controls="using:Musio_App.Controls">
                        <controls:RecordingPillControl
                            x:Name="DockedRecordingPill"
                            VerticalAlignment="Center"
                            MaxHeight="44" />
                        <Button
                            x:Name="DockedCollapseButton"
                            Click="DockedCollapseButton_Click"
                            Width="28" Height="28"
                            CornerRadius="6"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Collapse to Mini Recording"
                            AutomationProperties.Name="Collapse to Mini Recording">
                            <FontIcon Glyph="&#xE73F;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Record"
                    IsSelected="True"
                    Tag="record"
                    ToolTipService.ToolTip="Configure and start screen recording">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Editor"
                    Tag="editor"
                    ToolTipService.ToolTip="Edit your recorded clips">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE78A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</UserControl>
