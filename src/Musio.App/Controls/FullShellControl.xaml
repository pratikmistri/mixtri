<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.FullShellControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Musio"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <Grid Width="1024" Height="48" HorizontalAlignment="Stretch">
                    <Button
                        x:Name="CollapseButton"
                        Visibility="Visible"
                        Click="CollapseButton_Click"
                        Width="36" Height="36" Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,138,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Collapse to Mini"
                        AutomationProperties.Name="Collapse to Mini"
                        AutomationProperties.HelpText="Collapse the full app into the compact mini toolbar">
                        <FontIcon Glyph="&#xE73F;" FontSize="14" />
                    </Button>
                </Grid>
            </TitleBar.Content>

        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Record"
                    IsSelected="True"
                    Tag="record"
                    ToolTipService.ToolTip="Configure and start screen recording">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Editor"
                    Tag="editor"
                    ToolTipService.ToolTip="Edit your recorded clips">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE78A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>

        <!-- Right-aligned docked-pill action area. The static Full collapse
             button lives in TitleBar.Content so it participates in title-bar
             hit testing next to the caption controls. -->
        <Grid
            Grid.Row="0"
            MinWidth="36"
            Height="48"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,138,0">
            <StackPanel
                x:Name="DockedPillPanel"
                Visibility="Collapsed"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                xmlns:controls="using:Musio_App.Controls">
                <controls:RecordingPillControl
                    x:Name="DockedRecordingPill"
                    VerticalAlignment="Center"
                    MaxHeight="44" />
                <Button
                    x:Name="DockedCollapseButton"
                    Click="DockedCollapseButton_Click"
                    Width="28" Height="28"
                    CornerRadius="6"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Collapse to Mini Recording"
                    AutomationProperties.Name="Collapse to Mini Recording">
                    <FontIcon Glyph="&#xE73F;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Canvas Grid.RowSpan="2">
            <Button
                x:Name="CollapseOverlayButton"
                Visibility="Visible"
                Click="CollapseButton_Click"
                Width="36"
                Height="36"
                Padding="0"
                Canvas.Left="850"
                Canvas.Top="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ToolTipService.ToolTip="Collapse to Mini"
                AutomationProperties.Name="Collapse to Mini"
                AutomationProperties.HelpText="Collapse the full app into the compact mini toolbar">
                <FontIcon Glyph="&#xE73F;" FontSize="14" />
            </Button>
        </Canvas>
    </Grid>
</UserControl>
