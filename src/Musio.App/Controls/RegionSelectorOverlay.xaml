<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.RegionSelectorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerPressed="Grid_PointerPressed"
        PointerMoved="Grid_PointerMoved"
        PointerReleased="Grid_PointerReleased">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapePressed" />
            <KeyboardAccelerator Key="Enter" Invoked="OnEnterPressed" />
        </Grid.KeyboardAccelerators>

        <!-- Desktop screenshot background (set programmatically before showing) -->
        <Image x:Name="ScreenshotImage"
               Stretch="Fill"
               IsHitTestVisible="False" />

        <!-- Visual overlay layer (no hit test — pointer events handled by Grid) -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!-- Four dark mask rectangles forming the overlay around the selection -->
            <Rectangle x:Name="TopMask" Fill="{ThemeResource RegionMaskBrush}" />
            <Rectangle x:Name="BottomMask" Fill="{ThemeResource RegionMaskBrush}" />
            <Rectangle x:Name="LeftMask" Fill="{ThemeResource RegionMaskBrush}" />
            <Rectangle x:Name="RightMask" Fill="{ThemeResource RegionMaskBrush}" />

            <!-- Selection rectangle outline -->
            <Rectangle
                x:Name="SelectionRect"
                Fill="Transparent"
                Stroke="{ThemeResource RegionSelectionStrokeBrush}"
                StrokeThickness="1"
                StrokeDashArray="4,4"
                Visibility="Collapsed" />

            <!-- Resize handles (corners + edges) -->
            <Rectangle x:Name="HandleTL" Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Rectangle x:Name="HandleT"  Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Rectangle x:Name="HandleTR" Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Rectangle x:Name="HandleL"  Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Rectangle x:Name="HandleR"  Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Rectangle x:Name="HandleBL" Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Rectangle x:Name="HandleB"  Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Rectangle x:Name="HandleBR" Width="8" Height="8" Fill="{ThemeResource RegionHandleFillBrush}" Stroke="{ThemeResource RegionSelectionStrokeBrush}" StrokeThickness="1" Visibility="Collapsed" />

            <!-- Dimension label -->
            <Border
                x:Name="DimensionLabel"
                Background="{ThemeResource RegionLabelBackgroundBrush}"
                CornerRadius="4"
                Padding="8,4"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="DimensionText"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource OverlayForegroundBrush}" />
            </Border>
        </Canvas>

        <!-- Instruction text -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0"
            Padding="16,8"
            FontSize="16"
            Foreground="{ThemeResource OverlayForegroundBrush}"
            IsHitTestVisible="False"
            Text="Click and drag to adjust. Click Record on the toolbar to start. Esc to cancel." />

        <!-- The Confirm/Cancel/UseLast action buttons were removed; the
             toolbar's Record button is now the implicit confirm, Esc is
             cancel, and the previous region (if any) is pre-populated by
             the picker service via the initialRegion argument. -->
    </Grid>
</UserControl>
