<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.PropertyPanes.ScenePropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Musio_App.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:CheckedToBrushConverter x:Key="CheckedToBrush" />

        <!-- Aspect-ratio tile: bordered RadioButton hosting a proportional preview
             rectangle and label. Selected state lights up the border with the accent. -->
        <Style x:Key="AspectRatioTileStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="6,6,6,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TileRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="UncheckedNormal" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedNormal">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="TileRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="20" Margin="0,14,0,18">

        <!-- Aspect ratio grid: tile radios showing a proportional preview + label -->
        <StackPanel Spacing="8">
            <TextBlock Text="Aspect ratio" Style="{StaticResource PropertyLabelStyle}" />
            <Grid ColumnSpacing="6" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <RadioButton x:Name="RatioAuto" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="0" Grid.Column="0"
                             Tag="Auto">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="34" Height="24"
                                    Background="{Binding IsChecked, ElementName=RatioAuto, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=RatioAuto, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="A" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding IsChecked, ElementName=RatioAuto, Converter={StaticResource CheckedToBrush}, ConverterParameter=Glyph}" />
                        </Grid>
                        <TextBlock Text="Auto" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Ratio16x9" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="0" Grid.Column="1"
                             Tag="Landscape16x9">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="36" Height="20"
                                    Background="{Binding IsChecked, ElementName=Ratio16x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=Ratio16x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1.5" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="16:9" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Ratio9x16" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="0" Grid.Column="2"
                             Tag="Portrait9x16">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="14" Height="25"
                                    Background="{Binding IsChecked, ElementName=Ratio9x16, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=Ratio9x16, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1.5" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="9:16" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Ratio1x1" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="0" Grid.Column="3"
                             Tag="Square1x1">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="24" Height="24"
                                    Background="{Binding IsChecked, ElementName=Ratio1x1, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=Ratio1x1, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1.5" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="1:1" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Ratio4x5" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="1" Grid.Column="0"
                             Tag="Instagram4x5">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="20" Height="25"
                                    Background="{Binding IsChecked, ElementName=Ratio4x5, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=Ratio4x5, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1.5" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="4:5" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Ratio4x3" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="1" Grid.Column="1"
                             Tag="Classic4x3">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="32" Height="24"
                                    Background="{Binding IsChecked, ElementName=Ratio4x3, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=Ratio4x3, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1.5" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="4:3" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Ratio3x4" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="1" Grid.Column="2"
                             Tag="Tall3x4">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="18" Height="24"
                                    Background="{Binding IsChecked, ElementName=Ratio3x4, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=Ratio3x4, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1.5" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="3:4" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Ratio21x9" x:FieldModifier="public" GroupName="AspectRatioGrid"
                             Style="{StaticResource AspectRatioTileStyle}"
                             Grid.Row="1" Grid.Column="3"
                             Tag="Cinematic21x9">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Grid Width="36" Height="26">
                            <Border Width="36" Height="15"
                                    Background="{Binding IsChecked, ElementName=Ratio21x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Bg}"
                                    BorderBrush="{Binding IsChecked, ElementName=Ratio21x9, Converter={StaticResource CheckedToBrush}, ConverterParameter=Border}"
                                    BorderThickness="1.5" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="21:9" Style="{StaticResource PropertyTileCaptionStyle}" />
                    </StackPanel>
                </RadioButton>
            </Grid>
        </StackPanel>

        <!-- Fit mode: binary choice rendered as a segmented control -->
        <StackPanel x:Name="FitModePanel" x:FieldModifier="public" Spacing="8">
            <TextBlock Text="Fit" Style="{StaticResource PropertyLabelStyle}" />
            <ctk:Segmented x:Name="FitModeSegmented" x:FieldModifier="public"
                           HorizontalAlignment="Stretch">
                <ctk:SegmentedItem Content="Contain" Tag="Contain"
                                   ToolTipService.ToolTip="Fit entire source; gap filled with background" />
                <ctk:SegmentedItem Content="Cover" Tag="Cover"
                                   ToolTipService.ToolTip="Fill the canvas; source is cropped to fit" />
            </ctk:Segmented>
        </StackPanel>

        <!-- Zoom scope: binary choice rendered as a segmented control -->
        <StackPanel Spacing="8">
            <TextBlock Text="Zoom scope" Style="{StaticResource PropertyLabelStyle}" />
            <ctk:Segmented x:Name="ZoomScopeSegmented" x:FieldModifier="public"
                           HorizontalAlignment="Stretch">
                <ctk:SegmentedItem Content="Whole frame" Tag="Frame"
                                   ToolTipService.ToolTip="Zoom region spans the entire visible canvas, including background, letterbox and padding." />
                <ctk:SegmentedItem Content="Source only" Tag="Source"
                                   ToolTipService.ToolTip="Zoom region is constrained to the captured source; background, letterbox and padding stay fixed." />
            </ctk:Segmented>
        </StackPanel>

        <!-- Crop position picker: single rectangle subdivided into 9 cells.
             The selected cell fills with the accent color. -->
        <StackPanel x:Name="CropAnchorPanel" x:FieldModifier="public" Spacing="8">
            <TextBlock Text="Crop position" Style="{StaticResource PropertyLabelStyle}" />
            <Border HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SmallCornerRadius}">
                <Grid x:Name="CropAnchorGrid" x:FieldModifier="public"
                      AutomationProperties.Name="Crop anchor position"
                      AutomationProperties.HelpText="Choose where the crop is anchored within the source frame">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <!-- Vertical dividers -->
                    <Border Grid.Column="1" Grid.RowSpan="5"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Border Grid.Column="3" Grid.RowSpan="5"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <!-- Horizontal dividers -->
                    <Border Grid.Row="1" Grid.ColumnSpan="5"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Border Grid.Row="3" Grid.ColumnSpan="5"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                    <RadioButton GroupName="CropAnchor" Tag="0,0"
                                 AutomationProperties.Name="Top left"
                                 ToolTipService.ToolTip="Top left"
                                 Grid.Row="0" Grid.Column="0"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton GroupName="CropAnchor" Tag="0.5,0"
                                 AutomationProperties.Name="Top center"
                                 ToolTipService.ToolTip="Top center"
                                 Grid.Row="0" Grid.Column="2"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton GroupName="CropAnchor" Tag="1,0"
                                 AutomationProperties.Name="Top right"
                                 ToolTipService.ToolTip="Top right"
                                 Grid.Row="0" Grid.Column="4"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton GroupName="CropAnchor" Tag="0,0.5"
                                 AutomationProperties.Name="Middle left"
                                 ToolTipService.ToolTip="Middle left"
                                 Grid.Row="2" Grid.Column="0"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton x:Name="CropAnchorCenter" x:FieldModifier="public" GroupName="CropAnchor" Tag="0.5,0.5"
                                 AutomationProperties.Name="Center"
                                 ToolTipService.ToolTip="Center"
                                 Grid.Row="2" Grid.Column="2" IsChecked="True"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton GroupName="CropAnchor" Tag="1,0.5"
                                 AutomationProperties.Name="Middle right"
                                 ToolTipService.ToolTip="Middle right"
                                 Grid.Row="2" Grid.Column="4"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton GroupName="CropAnchor" Tag="0,1"
                                 AutomationProperties.Name="Bottom left"
                                 ToolTipService.ToolTip="Bottom left"
                                 Grid.Row="4" Grid.Column="0"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton GroupName="CropAnchor" Tag="0.5,1"
                                 AutomationProperties.Name="Bottom center"
                                 ToolTipService.ToolTip="Bottom center"
                                 Grid.Row="4" Grid.Column="2"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                    <RadioButton GroupName="CropAnchor" Tag="1,1"
                                 AutomationProperties.Name="Bottom right"
                                 ToolTipService.ToolTip="Bottom right"
                                 Grid.Row="4" Grid.Column="4"
                                 Style="{StaticResource AnchorGridCellStyle}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Section break: extra margin gives the divider room to read as a real
             separator rather than another row in the stack. -->
        <Border Height="1" Margin="0,6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <TextBlock Text="Background" Style="{StaticResource PropertySectionHeaderStyle}" />

        <!-- Preset picker -->
        <ComboBox HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="PresetCombo"
            x:FieldModifier="public"
            Header="Preset"
            HorizontalAlignment="Stretch" />

        <!-- Background type -->
        <ComboBox HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="BgTypeCombo"
            x:FieldModifier="public"
            Header="Background"
            HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Solid Color" Tag="SolidColor" />
            <ComboBoxItem Content="Gradient" Tag="Gradient" />
            <ComboBoxItem Content="Wallpaper" Tag="Image" />
            <ComboBoxItem Content="Blur" Tag="Blur" />
        </ComboBox>

        <!-- Primary color -->
        <StackPanel x:Name="ColorPanel" x:FieldModifier="public" Spacing="6">
            <TextBlock Text="Color" Style="{StaticResource PropertyLabelStyle}" />
            <DropDownButton HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="BgColorSwatch"
                        x:FieldModifier="public"
                        Width="20" Height="20"
                        CornerRadius="{StaticResource SmallCornerRadius}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" />
                    <TextBlock x:Name="BgColorText" x:FieldModifier="public" Text="#1a1a2e" VerticalAlignment="Center" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout>
                        <ColorPicker
                            x:Name="BgColorPicker"
                            x:FieldModifier="public"
                            IsAlphaEnabled="False"
                            IsHexInputVisible="True" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- Gradient end color (only visible for Gradient type) -->
        <StackPanel x:Name="GradientPanel" x:FieldModifier="public" Spacing="6" Visibility="Collapsed">
            <TextBlock Text="Gradient End Color" Style="{StaticResource PropertyLabelStyle}" />
            <DropDownButton HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="GradEndColorSwatch"
                        x:FieldModifier="public"
                        Width="20" Height="20"
                        CornerRadius="{StaticResource SmallCornerRadius}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" />
                    <TextBlock x:Name="GradEndColorText" x:FieldModifier="public" Text="#16213e" VerticalAlignment="Center" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout>
                        <ColorPicker
                            x:Name="GradEndColorPicker"
                            x:FieldModifier="public"
                            IsAlphaEnabled="False"
                            IsHexInputVisible="True" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Slider HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
                x:Name="GradAngleSlider"
                x:FieldModifier="public"
                Header="Gradient Angle"
                Minimum="0" Maximum="360"
                StepFrequency="5" />
        </StackPanel>

        <!-- Wallpaper picker (only visible for Wallpaper/Image type) -->
        <StackPanel x:Name="WallpaperPanel" x:FieldModifier="public" Spacing="6" Visibility="Collapsed">
            <TextBlock Text="Wallpaper" Style="{StaticResource PropertyLabelStyle}" />
            <!-- Unbounded height with scrolling disabled: the grid grows to fit its tiles
                 and the panel's own ScrollViewer handles the overflow, so the user never
                 gets a second scrollbar nested inside the pane.
                 Tiles are sized to the pane width in WallpaperGrid_SizeChanged. -->
            <GridView
                x:Name="WallpaperGrid"
                x:FieldModifier="public"
                Padding="0"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Single">
                <GridView.ItemContainerStyle>
                    <!-- BasedOn keeps the stock selection/hover visuals; a bare Style would
                         replace the default outright and drop them. -->
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <!-- The gutter lives on the container, not the tile inside it: the
                             selection visual is drawn around the container, so insetting
                             the tile instead would leave the selection box hanging into the
                             gap and touching the neighbouring tile. -->
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>
        </StackPanel>

        <!-- Padding -->
        <Slider HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="PaddingSlider"
            x:FieldModifier="public"
            Header="Padding"
            Minimum="0" Maximum="120"
            StepFrequency="4" />

        <!-- Corner radius -->
        <Slider HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="CornerRadiusSlider"
            x:FieldModifier="public"
            Header="Corner Radius"
            Minimum="0" Maximum="32"
            StepFrequency="2" />

        <!-- Shadow -->
        <ToggleSwitch HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="ShadowToggle"
            x:FieldModifier="public"
            Header="Shadow" />

        <!-- Border -->
        <ToggleSwitch HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="BorderToggle"
            x:FieldModifier="public"
            Header="Border" />

        <!-- Section break: extra margin gives the divider room to read as a real
             separator rather than another row in the stack. -->
        <Border Height="1" Margin="0,6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <TextBlock Text="Motion" Style="{StaticResource PropertySectionHeaderStyle}" />

        <!-- Motion blur: global, applies while the cursor moves and the view zooms/pans. -->
        <StackPanel Spacing="6">
            <ToggleSwitch HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
                x:Name="MotionBlurToggle"
                x:FieldModifier="public"
                Header="Motion Blur" />
            <TextBlock
                Text="Cinematic blur while the cursor moves and the view zooms."
                Style="{StaticResource PropertyHintStyle}" />
        </StackPanel>

        <Slider HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="MotionBlurSlider"
            x:FieldModifier="public"
            Header="Blur Amount"
            Minimum="0" Maximum="100"
            StepFrequency="5" />

        <!-- Camera drift: global, keeps a scene gently moving for the whole zoom segment. -->
        <StackPanel Spacing="6">
            <ToggleSwitch HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
                x:Name="CameraDriftToggle"
                x:FieldModifier="public"
                Header="Camera Drift" />
            <TextBlock
                Text="Keeps the scene gently moving during zoom segments."
                Style="{StaticResource PropertyHintStyle}" />
        </StackPanel>

        <Slider HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="CameraDriftSlider"
            x:FieldModifier="public"
            Header="Drift Amount"
            Minimum="0" Maximum="200"
            StepFrequency="5" />
    </StackPanel>
</UserControl>
