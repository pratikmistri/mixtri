<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Musio_App.Controls.PropertyPanes.ZoomPropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Properties for the currently selected zoom segment (moved out of the old
        ZoomSegmentPanel toolbar strip in EditorPage.xaml, which ran out of room next to
        the Save/Export buttons). EditorPage owns all editing logic and undo; this file is
        markup only.
    -->
    <UserControl.Resources>
        <!-- Same path geometry as Assets\Icons\Drift.svg (viewBox 0 0 20 20), inlined as a
             PathIcon Data string (the form already proven in EditorPage.xaml) so it inherits
             the section header's Foreground and follows the theme, which a fixed-fill
             SvgImageSource cannot. Keep the two in sync if the shape changes. -->
        <DataTemplate x:Key="DriftHeaderTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="14" Height="14"
                          Data="M2,7.5 L2,3.5 A1.5,1.5 0 0 1 3.5,2 L7.5,2 L7.5,3.4 L3.4,3.4 L3.4,7.5 Z M18,7.5 L18,3.5 A1.5,1.5 0 0 0 16.5,2 L12.5,2 L12.5,3.4 L16.6,3.4 L16.6,7.5 Z M2,12.5 L2,16.5 A1.5,1.5 0 0 0 3.5,18 L7.5,18 L7.5,16.6 L3.4,16.6 L3.4,12.5 Z M18,12.5 L18,16.5 A1.5,1.5 0 0 1 16.5,18 L12.5,18 L12.5,16.6 L16.6,16.6 L16.6,12.5 Z M4.40,11.50 A6.6,6.6 0 0 1 14.07,9.80 L12.36,10.82 A5.3,5.3 0 0 0 4.61,12.19 Z M12.88,11.30 A1.6,1.6 0 1 0 16.08,11.30 A1.6,1.6 0 1 0 12.88,11.30 Z" />
                <TextBlock Text="{Binding}" Style="{StaticResource PropertyLabelStyle}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="20" Margin="0,14,0,18">

        <!-- Zoom level: applies to the selected segment. -->
        <StackPanel Spacing="6">
            <TextBlock Text="Zoom Level" Style="{StaticResource PropertyLabelStyle}" />
            <ComboBox
                x:Name="ZoomLevelCombo"
                x:FieldModifier="public"
                IsEditable="True"
                HorizontalAlignment="Stretch"
                ToolTipService.ToolTip="Zoom level applied to the selected segment"
                AutomationProperties.Name="Zoom level">
                <ComboBoxItem Content="1x" Tag="1" />
                <ComboBoxItem Content="1.5x" Tag="1.5" />
                <ComboBoxItem Content="2x" Tag="2" />
                <ComboBoxItem Content="2.5x" Tag="2.5" />
                <ComboBoxItem Content="3x" Tag="3" />
                <ComboBoxItem Content="4x" Tag="4" />
            </ComboBox>
        </StackPanel>

        <Button
            x:Name="EditZoomRegionButton"
            x:FieldModifier="public"
            HorizontalAlignment="Stretch"
            ToolTipService.ToolTip="Position the zoom visually on the frame"
            AutomationProperties.Name="Edit zoom region">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon FontSize="14" Glyph="&#xE78A;" />
                <TextBlock Text="Edit Region" />
            </StackPanel>
        </Button>

        <!-- Section break: extra margin gives the divider room to read as a real
             separator rather than another row in the stack. -->
        <Border Height="1" Margin="0,-6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Camera drift: per-segment, not scene-wide (see hint below). -->
        <StackPanel Spacing="6">
            <ToggleSwitch
                x:Name="ZoomDriftToggle"
                x:FieldModifier="public"
                HeaderTemplate="{StaticResource DriftHeaderTemplate}"
                Header="Camera Drift"
                ToolTipService.ToolTip="Keeps this segment gently moving with a slow push and pan across the hold"
                AutomationProperties.Name="Camera drift" />
            <TextBlock
                Style="{StaticResource PropertyHintStyle}"
                Text="Applies to this zoom segment only, not the whole scene." />
        </StackPanel>

        <Slider HeaderTemplate="{StaticResource PropertyHeaderTemplate}"
            x:Name="ZoomDriftSlider"
            x:FieldModifier="public"
            Header="Drift Amount"
            Minimum="0" Maximum="200"
            StepFrequency="5"
            ToolTipService.ToolTip="50% is the tuned default"
            AutomationProperties.Name="Drift amount" />

        <Button
            x:Name="RemoveZoomSegmentButton"
            x:FieldModifier="public"
            HorizontalAlignment="Stretch"
            ToolTipService.ToolTip="Remove the selected zoom segment"
            AutomationProperties.Name="Remove zoom segment">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                <TextBlock Text="Remove Zoom Segment" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
