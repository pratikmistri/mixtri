<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Musio.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-100.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-16.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-32.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-256.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-16_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-32_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-256_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!--
    Copy packaged assets (app icon + tile/taskbar logos) into the build output so the
    loose layout works when the app is registered for local dev via
    `Add-AppxPackage -Register win-<arch>\AppxManifest.xml`. Without this, a plain Build
    only packages these at MSIX-packaging time, so the dev build can't find
    Assets\AppIcon.ico (used by AppWindow.SetIcon / TitleBar / SystemTrayService) and
    falls back to the default Windows icon.
  -->
  <ItemGroup>
    <Content Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!-- This is a temporary workaround to test dotnet new template - it will block vstemplate from working -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Musio.Core\Musio.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
  </PropertyGroup>

  <!--
    Dev branding: a locally deployed build installs SIDE BY SIDE with the Store build and is
    named "Musio (dev)", so both can be present at once and it is obvious at a glance (Start
    menu, taskbar, Settings > Apps, in-app title bar) which is which. The Store build keeps
    both its plain "Musio" name and its real identity, and is never touched by any of this.

    Side-by-side requires a distinct package Identity/Name: Windows keys an installed package
    on its identity, so a dev build sharing "PratikMistri.Musio" REPLACES the Store install
    rather than joining it. The dev identity therefore becomes "PratikMistri.Musio.Dev", which
    also gives the dev build its own package family name, its own ApplicationData.LocalSettings
    and its own Start menu entry. Publisher is deliberately left alone — registering a loose
    layout under developer mode does not check it, and changing it would gain nothing.

    The switch is which KIND of output is being produced, not Debug vs Release — a local
    deployment is commonly a Release build, so keying off $(Configuration) would mislabel
    it. MSIX packaging for the Store sets GenerateAppxPackageOnBuild=true (see the MSIX
    playbook in learnings/playbooks.md), and that is the only build whose name and identity
    must stay clean. Pass /p:MusioDevBranding=false to force Store naming for any other build.
  -->
  <PropertyGroup>
    <MusioDevBranding Condition="'$(MusioDevBranding)' == '' and '$(GenerateAppxPackageOnBuild)' == 'true'">false</MusioDevBranding>
    <MusioDevBranding Condition="'$(MusioDevBranding)' == ''">true</MusioDevBranding>
    <MusioDevBrandingSuffix Condition="'$(MusioDevBrandingSuffix)' == ''">(dev)</MusioDevBrandingSuffix>
    <MusioDevIdentitySuffix Condition="'$(MusioDevIdentitySuffix)' == ''">.Dev</MusioDevIdentitySuffix>
  </PropertyGroup>

  <!--
    Rewrites the identity and display names in the AppxManifest.xml that lands in the build
    output — which is exactly the file `Add-AppxPackage -Register` consumes for a dev deployment.

    Every value is read from the CHECKED-IN Package.appxmanifest and written to the OUTPUT copy.
    That direction matters: the source is never modified, so the target is idempotent even when
    an incremental build leaves an already-branded manifest in the output (reading the output
    and appending would produce "Musio (dev) (dev)" / "...Musio.Dev.Dev"). It also means
    renaming the app only requires editing Package.appxmanifest.

    Identity/@Name is what makes the install side-by-side rather than a replacement.
    Properties/DisplayName drives Settings > Apps; VisualElements/@DisplayName drives the
    Start menu and taskbar. All three are set, or the dev build is either indistinguishable
    from the Store build or named inconsistently.
  -->
  <Target Name="ApplyMusioDevBranding"
          AfterTargets="Build"
          Condition="'$(MusioDevBranding)' == 'true' and Exists('$(OutDir)AppxManifest.xml')">
    <PropertyGroup>
      <_MusioAppxNamespaces>
        &lt;Namespace Prefix="d" Uri="http://schemas.microsoft.com/appx/manifest/foundation/windows10" /&gt;
        &lt;Namespace Prefix="uap" Uri="http://schemas.microsoft.com/appx/manifest/uap/windows10" /&gt;
      </_MusioAppxNamespaces>
    </PropertyGroup>

    <XmlPeek XmlInputPath="Package.appxmanifest"
             Namespaces="$(_MusioAppxNamespaces)"
             Query="/d:Package/d:Identity/@Name">
      <Output TaskParameter="Result" PropertyName="_MusioIdentityName" />
    </XmlPeek>

    <XmlPeek XmlInputPath="Package.appxmanifest"
             Namespaces="$(_MusioAppxNamespaces)"
             Query="/d:Package/d:Properties/d:DisplayName/text()">
      <Output TaskParameter="Result" PropertyName="_MusioPackageDisplayName" />
    </XmlPeek>

    <XmlPeek XmlInputPath="Package.appxmanifest"
             Namespaces="$(_MusioAppxNamespaces)"
             Query="/d:Package/d:Applications/d:Application/uap:VisualElements/@DisplayName">
      <Output TaskParameter="Result" PropertyName="_MusioAppDisplayName" />
    </XmlPeek>

    <XmlPoke XmlInputPath="$(OutDir)AppxManifest.xml"
             Namespaces="$(_MusioAppxNamespaces)"
             Query="/d:Package/d:Identity/@Name"
             Value="$(_MusioIdentityName)$(MusioDevIdentitySuffix)" />

    <XmlPoke XmlInputPath="$(OutDir)AppxManifest.xml"
             Namespaces="$(_MusioAppxNamespaces)"
             Query="/d:Package/d:Properties/d:DisplayName"
             Value="$(_MusioPackageDisplayName) $(MusioDevBrandingSuffix)" />

    <XmlPoke XmlInputPath="$(OutDir)AppxManifest.xml"
             Namespaces="$(_MusioAppxNamespaces)"
             Query="/d:Package/d:Applications/d:Application/uap:VisualElements/@DisplayName"
             Value="$(_MusioAppDisplayName) $(MusioDevBrandingSuffix)" />

    <Message Importance="high"
             Text="Dev branding applied: &quot;$(_MusioAppDisplayName) $(MusioDevBrandingSuffix)&quot; with identity $(_MusioIdentityName)$(MusioDevIdentitySuffix), installable alongside the Store build. Build with /p:MusioDevBranding=false for the Store name and identity." />
  </Target>
</Project>
