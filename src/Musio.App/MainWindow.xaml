<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Musio_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Musio_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Musio"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Musio"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Store-style rail: a fixed-width pane that is always open but never expandable,
             so there is no hamburger and no flyout.

             NavigationView has no built-in icon-over-label mode, so each item supplies that
             layout through ContentTemplate, with Content carrying the label. The layout must
             go in a template and NOT directly in Content — assigning a UIElement to
             NavigationViewItem.Content crashes the XAML runtime (0xc000027b) as the item is
             realised. Icon is deliberately left unset so the presenter reserves no icon
             column and the stacked content can centre in the rail. -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="72"
            CompactPaneLength="0"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <DataTemplate x:Key="RecordItemTemplate">
                    <StackPanel Spacing="6" Padding="0,10">
                        <FontIcon FontSize="18" Glyph="&#xE7C8;" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:Key="EditorItemTemplate">
                    <StackPanel Spacing="6" Padding="0,10">
                        <FontIcon FontSize="18" Glyph="&#xE78A;" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:Key="SettingsItemTemplate">
                    <StackPanel Spacing="6" Padding="0,10">
                        <FontIcon FontSize="18" Glyph="&#xE713;" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Tag="record"
                    Content="Record"
                    IsSelected="True"
                    ContentTemplate="{StaticResource RecordItemTemplate}"
                    ToolTipService.ToolTip="Configure and start screen recording" />
                <NavigationViewItem
                    Tag="editor"
                    Content="Editor"
                    ContentTemplate="{StaticResource EditorItemTemplate}"
                    ToolTipService.ToolTip="Edit your recorded clips" />
            </NavigationView.MenuItems>
            <!-- Settings uses a footer item rather than NavigationView's built-in one so it
                 gets the same stacked layout as the rest of the rail. -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Tag="settings"
                    Content="Settings"
                    ContentTemplate="{StaticResource SettingsItemTemplate}"
                    ToolTipService.ToolTip="App settings" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
