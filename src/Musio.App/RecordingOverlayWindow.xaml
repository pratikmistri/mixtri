<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Musio_App.RecordingOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Musio Recording">

    <Grid Padding="14,8">
        <Grid.Background>
            <AcrylicBrush
                TintColor="#1E1E1E"
                TintOpacity="0.8"
                FallbackColor="#E01E1E1E" />
        </Grid.Background>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
            <!-- Recording indicator dot -->
            <Ellipse
                Width="10"
                Height="10"
                Fill="#FFFF3B30"
                VerticalAlignment="Center" />

            <!-- Elapsed time (bound to RecordingViewModel.ElapsedTime) -->
            <TextBlock
                x:Name="ElapsedText"
                Text="00:00"
                Foreground="White"
                FontSize="15"
                FontWeight="SemiBold"
                FontFamily="Consolas"
                VerticalAlignment="Center"
                MinWidth="48" />
        </StackPanel>

        <!-- Stop icon button aligned to right -->
        <Button
            x:Name="StopButton"
            Click="Stop_Click"
            Width="32"
            Height="32"
            CornerRadius="16"
            Padding="0"
            Background="#40FF3B30"
            BorderBrush="#60FF3B30"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            ToolTipService.ToolTip="Stop recording">
            <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#FFFF3B30" />
        </Button>
    </Grid>
</Window>
