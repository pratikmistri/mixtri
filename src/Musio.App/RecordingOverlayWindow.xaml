<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Musio_App.RecordingOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Musio Recording">

    <Grid Background="#E01E1E1E" Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <!-- Recording indicator dot -->
            <Ellipse
                Width="10"
                Height="10"
                Fill="#FFFF3B30"
                VerticalAlignment="Center" />

            <!-- Elapsed time (bound to RecordingViewModel.ElapsedTime) -->
            <TextBlock
                x:Name="ElapsedText"
                Text="00:00"
                Foreground="White"
                FontSize="15"
                FontWeight="SemiBold"
                FontFamily="Consolas"
                VerticalAlignment="Center"
                MinWidth="48" />

            <!-- Stop button -->
            <Button
                x:Name="StopButton"
                Click="Stop_Click"
                CornerRadius="14"
                Padding="12,5"
                Background="#40FF3B30"
                BorderBrush="#60FF3B30"
                ToolTipService.ToolTip="Stop recording">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#FFFF3B30" />
                    <TextBlock Text="Stop" FontSize="13" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
