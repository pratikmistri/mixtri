<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mixtri_App.Controls.WindowSelectorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        PointerMoved="Grid_PointerMoved"
        PointerPressed="Grid_PointerPressed">

        <!-- Hidden placement: the accelerator belongs to the grid, not to a button, so WinUI
             would park its automatic key-combination tooltip over the screenshot the user is
             trying to pick a window from. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapePressed" />
        </Grid.KeyboardAccelerators>

        <!-- Desktop screenshot background -->
        <Image x:Name="ScreenshotImage"
               Stretch="Fill"
               IsHitTestVisible="False" />

        <!-- Visual overlay layer -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!-- Four dark mask rectangles forming the dim overlay around the highlighted
                 window. Uses the same brush as the region selector so both pickers dim
                 the desktop by the same amount and both follow High Contrast. -->
            <Rectangle x:Name="TopMask" Fill="{ThemeResource RegionMaskBrush}" />
            <Rectangle x:Name="BottomMask" Fill="{ThemeResource RegionMaskBrush}" />
            <Rectangle x:Name="LeftMask" Fill="{ThemeResource RegionMaskBrush}" />
            <Rectangle x:Name="RightMask" Fill="{ThemeResource RegionMaskBrush}" />

            <!-- Highlight border around hovered window. Shares the region selector's
                 accent stroke, dash pattern, thickness and corner radius so "this is
                 what gets captured" reads identically in both pickers and in the
                 persistent selection border. -->
            <Rectangle
                x:Name="HighlightRect"
                Fill="Transparent"
                Stroke="{ThemeResource RegionSelectionStrokeBrush}"
                StrokeThickness="2"
                StrokeDashArray="3.5,2.5"
                RadiusX="4"
                RadiusY="4"
                Visibility="Collapsed" />

            <!-- Window info label -->
            <Border
                x:Name="WindowInfoLabel"
                Background="{ThemeResource RegionLabelBackgroundBrush}"
                CornerRadius="4"
                Padding="10,6"
                Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="WindowTitleText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource OverlayForegroundBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="400" />
                    <TextBlock
                        x:Name="WindowProcessText"
                        FontSize="11"
                        Foreground="{ThemeResource OverlayForegroundBrush}"
                        Opacity="0.7" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Instruction text -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0"
            Padding="16,8"
            FontSize="16"
            Foreground="{ThemeResource OverlayForegroundBrush}"
            IsHitTestVisible="False"
            Text="Click on a window to select it. Press Escape to cancel." />
    </Grid>
</UserControl>
